{
  "name": "forgeon-automation-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:noCheck": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "check:h1": "node scripts/check-h1.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:locale-routes": "node scripts/check-locale-routes.mjs",
    "build:datasheet": "node scripts/build-datasheet.mjs",
    "test:e2e": "playwright test",
    "test:axe": "playwright test tests/e2e/axe.spec.ts",
    "review:bundle": "bash scripts/create-review-bundle.sh",
    "agent:doctor": "python3 scripts/agent_workflow.py doctor",
    "agent:init-runtime": "python3 scripts/agent_workflow.py init-runtime",
    "agent:status": "python3 scripts/agent_workflow.py status",
    "agent:claim": "python3 scripts/agent_workflow.py claim",
    "agent:step-start": "python3 scripts/agent_workflow.py step-start",
    "agent:step-complete": "python3 scripts/agent_workflow.py step-complete",
    "agent:test": "python3 scripts/agent_workflow.py test",
    "agent:stage-ticket": "python3 scripts/agent_workflow.py stage-ticket",
    "agent:commit-ticket": "python3 scripts/agent_workflow.py commit-ticket",
    "agent:checkpoint": "python3 scripts/agent_workflow.py checkpoint",
    "agent:handoff": "python3 scripts/agent_workflow.py handoff",
    "agent:resume": "python3 scripts/agent_workflow.py resume",
    "agent:recover": "python3 scripts/agent_workflow.py recover",
    "agent:complete": "python3 scripts/agent_workflow.py complete",
    "agent:human-abort": "python3 scripts/agent_workflow.py human-abort",
    "agent:validate": "python3 scripts/agent_workflow.py validate",
    "agent:snapshot": "python3 scripts/agent_workflow.py snapshot",
    "agent:watch": "python3 scripts/agent_watcher.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.3"
  }
}

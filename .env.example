# FORGEON AUTOMATION demo site — environment variables
# Copy this file to .env and fill in real values before production deployment.
# See README.md for full setup instructions.

# Public site origin used for canonical URLs, sitemap, and Open Graph tags.
# Falls back to a placeholder demo URL when unset (see astro.config.mjs).
PUBLIC_SITE_URL=https://forgeon-demo.yegou.studio

# RFQ / contact form submission endpoint.
# When unset, the contact form runs in Demo Mode: no data leaves the browser
# and the UI clearly labels submissions as non-functional demo behavior.
# Set this to a real endpoint (e.g. a serverless function, Formspree, or your
# CRM webhook) to enable live form submission.
PUBLIC_RFQ_ENDPOINT=

# Optional: Google Tag Manager container ID (e.g. GTM-XXXXXXX). This is the
# ONLY analytics script this codebase actually loads (see BaseLayout.astro).
# Route GA4 through a GTM container/tag rather than direct gtag.js — see
# README.md "Analytics" for the step-by-step GTM/GA4 event tag setup. When
# unset, no analytics script of any kind is loaded.
PUBLIC_GTM_ID=

# --- Demo Mode / indexing gate (see docs/REMEDIATION_PLAN.md P0.4) ---
# This is a fictional portfolio concept site, not a real company. Demo Mode
# defaults ON (even if you delete this line) so the site always ships
# noindex + robots Disallow: / unless BOTH flags below are set explicitly.
#
# Demo Mode (default): every page gets <meta name="robots"
# content="noindex,nofollow">, robots.txt returns "Disallow: /", the
# Organization/Product JSON-LD self-identifies as a fictional Concept
# Project, and a small "Concept Project" badge shows in the footer.
# Set to "false" (together with PUBLIC_ALLOW_INDEXING=true below) only if
# you are deploying this as a REAL, indexable site.
PUBLIC_DEMO_MODE=true

# Production Mode indexing opt-in. Only takes effect when
# PUBLIC_DEMO_MODE=false. Leaving this unset/false keeps the site
# non-indexable even if Demo Mode is turned off for some other reason.
PUBLIC_ALLOW_INDEXING=false

# FORGEON AUTOMATION demo site — environment variables
# Copy this file to .env and fill in real values before production deployment.
# See README.md for full setup instructions.

# Public site origin used for canonical URLs, sitemap, and Open Graph tags.
# Falls back to a placeholder demo URL when unset (see astro.config.mjs).
PUBLIC_SITE_URL=https://forgeon-demo.yegou.studio

# RFQ / contact form submission endpoint.
# When unset, the contact form runs in Demo Mode: no data leaves the browser
# and the UI clearly labels submissions as non-functional demo behavior.
# Set this to a real endpoint (e.g. a serverless function, Formspree, or your
# CRM webhook) to enable live form submission.
PUBLIC_RFQ_ENDPOINT=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When unset, no analytics script is loaded. See README.md "Analytics".
PUBLIC_GA4_ID=

# Optional: Google Tag Manager container ID (e.g. GTM-XXXXXXX).
PUBLIC_GTM_ID=

---
/**
 * Thin wrapper enforcing explicit width/height (prevents CLS, spec §16/§23)
 * and lazy-loading for below-the-fold images. Used for SVG/raster assets
 * that are not processed through astro:assets.
 */
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, width, height, loading = 'lazy', class: className = '', fetchpriority = 'auto' } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
/>

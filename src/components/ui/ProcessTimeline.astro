---
export interface Step {
  title: string;
  description: string;
}
export interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="process-timeline">
  {steps.map((step, i) => (
    <li class="process-timeline__item">
      <span class="process-timeline__index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="process-timeline__body">
        <h3 class="process-timeline__title">{step.title}</h3>
        <p class="process-timeline__desc">{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .process-timeline__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
    position: relative;
  }
  .process-timeline__item:first-child {
    border-top: none;
  }
  .process-timeline__index {
    font-size: var(--fs-sm);
    /*
     * CC-01 token-compatibility fix, found via axe-core in
     * tests/e2e/axe.spec.ts (real regression, not a false positive):
     * ProcessTimeline is always rendered inside a `.section--alt` (see
     * every call site: homepage, Solution Detail, About), whose background
     * is `--color-surface-alt` = `--color-paper-100`. The Precision Datum
     * palette's `--color-accent` (= `--color-copper-600`, #b84e1d) was
     * verified in docs/CONTRAST_AUDIT.md to measure only 4.19:1 on
     * `--color-paper-100` — below the 4.5:1 text threshold, exactly the
     * failure axe-core caught live in the rendered page
     * (measured 4.18:1, matching the audit's calculation). `--color-accent
     * -dark` (= `--color-copper-700`, #9c4014) is the token this palette
     * specifically added for this "copper text on the tinted paper-100
     * background" case — verified at 5.50:1. Same hue family, no other
     * visual change; not a component redesign.
     */
    color: var(--color-accent-dark);
    font-weight: 700;
    padding-top: 0.15em;
  }
  .process-timeline__title {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-2xs);
  }
  .process-timeline__desc {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  @media (min-width: 720px) {
    .process-timeline__item {
      grid-template-columns: 60px 1fr;
    }
  }
</style>

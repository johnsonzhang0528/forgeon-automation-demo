---
export interface Step {
  title: string;
  description: string;
}
export interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="process-timeline">
  {steps.map((step, i) => (
    <li class="process-timeline__item">
      <span class="process-timeline__index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="process-timeline__body">
        <h3 class="process-timeline__title">{step.title}</h3>
        <p class="process-timeline__desc">{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .process-timeline__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
    position: relative;
  }
  .process-timeline__item:first-child {
    border-top: none;
  }
  .process-timeline__index {
    font-size: var(--fs-sm);
    color: var(--color-accent);
    font-weight: 700;
    padding-top: 0.15em;
  }
  .process-timeline__title {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-2xs);
  }
  .process-timeline__desc {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  @media (min-width: 720px) {
    .process-timeline__item {
      grid-template-columns: 60px 1fr;
    }
  }
</style>

---
/**
 * Product-facing presentation for the accepted YF-IMG-04, YF-IMG-05 and
 * YF-IMG-07 production masters. Product cards use decorative, lazy-loaded
 * crops while product heroes retain localized alt text and representative /
 * concept-image disclosure.
 */
import { Picture } from 'astro:assets';
import machineVisionImage from '../../assets/images/solutions/machine-vision-inspection-final-master.png';
import precisionHandlingImage from '../../assets/images/solutions/precision-motion-handling-final-master.png';
import modularWorkstationImage from '../../assets/images/products/modular-assembly-workstation-final-master.png';
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';

export interface Props {
  locale: Locale;
  product: 'axm-400' | 'vision-x2' | 'flexcell-m';
  placement?: 'card' | 'hero';
  priority?: boolean;
}

const { locale, product, placement = 'card', priority } = Astro.props;
const productionImagery = getDictionary(locale).productionImagery;
const images = {
  'vision-x2': {
      src: machineVisionImage,
      id: 'YF-IMG-04',
      copy: productionImagery.machineVisionInspection,
  },
  'axm-400': {
    src: precisionHandlingImage,
    id: 'YF-IMG-05',
    copy: productionImagery.precisionHandling,
  },
  'flexcell-m': {
    src: modularWorkstationImage,
    id: 'YF-IMG-07',
    copy: productionImagery.modularWorkstation,
  },
} as const;
const image = images[product];
const isPriority = priority ?? placement === 'hero';
const presentation = placement === 'hero' ? 'product-hero' : 'product-card';
const sizes = placement === 'hero'
  ? '(min-width: 1200px) 520px, (min-width: 860px) 46vw, (min-width: 480px) calc(100vw - 48px), calc(100vw - 32px)'
  : '(min-width: 1200px) 360px, (min-width: 760px) 44vw, calc(100vw - 32px)';
---

<figure
  class:list={[
    'product-visual',
    `product-visual--${placement}`,
    `product-visual--${product}`,
  ]}
  data-production-image={image.id}
  data-presentation={presentation}
  data-product-image={product}
>
  <div class="product-visual__media">
    <Picture
      src={image.src}
      formats={['avif', 'webp']}
      widths={[360, 480, 640, 768, 1024, 1280]}
      sizes={sizes}
      alt={placement === 'card' ? '' : image.copy.alt}
      loading={isPriority ? 'eager' : 'lazy'}
      fetchpriority={isPriority ? 'high' : 'auto'}
      decoding="async"
      quality={82}
    />
  </div>
  {placement === 'hero' && (
    <figcaption class="product-visual__caption">
      <span class="product-visual__marker" aria-hidden="true"></span>
      <span>{image.copy.caption}</span>
    </figcaption>
  )}
</figure>

<style>
  .product-visual {
    min-width: 0;
    margin: 0;
  }

  .product-visual__media {
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .product-visual--card .product-visual__media {
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--color-border);
  }

  .product-visual--hero .product-visual__media {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-border);
  }

  .product-visual__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-visual__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-visual--vision-x2 .product-visual__media :global(img) {
    object-position: 50% 52%;
  }

  .product-visual--axm-400 .product-visual__media :global(img) {
    object-position: 50% 55%;
  }

  .product-visual--flexcell-m .product-visual__media :global(img) {
    object-position: 50% 52%;
  }

  .product-visual__caption {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  .product-visual__marker {
    display: block;
    width: 100%;
    height: 2px;
    margin-top: 0.55em;
    background: var(--color-accent);
  }

  @media (min-width: 480px) {
    .product-visual--hero .product-visual__media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 768px) {
    .product-visual--hero.product-visual--axm-400 .product-visual__media,
    .product-visual--hero.product-visual--flexcell-m .product-visual__media {
      aspect-ratio: 3 / 2;
    }

    .product-visual__caption {
      grid-template-columns: 3rem minmax(0, 36rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-visual__media,
    .product-visual__media :global(img) {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

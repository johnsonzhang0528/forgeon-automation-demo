---
/**
 * Shared card shell — no shadow until hover, hairline border, no
 * cards-inside-cards. Consumed by SolutionCard / ProductCard / IndustryCard.
 *
 * `padding` is a real, typed prop (not a `class` string a parent passes in
 * and then tries to override from its own scoped <style>). Astro scoped CSS
 * only tags DOM nodes rendered directly inside a component's own template,
 * so a rule like ProductCard's old `.product-card { padding: 0 }` never
 * matched the <a class="card"> node actually rendered by this file — see
 * docs/REMEDIATION_PLAN.md P0.1. Consumers that need a different padding
 * (ProductCard flushes it to 0 so ProductGlyph can bleed to the card edge)
 * now say so explicitly via this prop.
 */
export interface Props {
  href: string;
  padding?: 'default' | 'none';
  class?: string;
}
const { href, padding = 'default', class: className = '' } = Astro.props;
---

<a href={href} class:list={['card', `card--padding-${padding}`, className]}>
  <slot />
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }
  .card--padding-none {
    padding: 0;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--color-border-strong);
    background: color-mix(in srgb, var(--color-card) 92%, var(--color-surface-alt));
    transform: translateY(-1px);
  }
</style>

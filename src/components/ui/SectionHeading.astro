---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  level?: 'h1' | 'h2' | 'h3';
  /**
   * Quiet, compact treatment for supporting sections that should not
   * compete visually with the page's signature moments (Hero / mid-page
   * signature / conversion ending). Smaller title, no leading datum mark,
   * tighter spacing. Opt-in only — every existing call site keeps its
   * current full-weight rendering unless it explicitly passes this.
   */
  compact?: boolean;
}

const { eyebrow, title, description, align = 'left', level = 'h2', compact = false } = Astro.props;
const Tag = level;
---

<div class:list={['section-heading', { 'section-heading--center': align === 'center', 'section-heading--compact': compact }]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Tag class="section-heading__title">{title}</Tag>
  {description && <p class="section-heading__desc measure">{description}</p>}
</div>

<style>
  .section-heading {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    max-width: 56rem;
    margin-bottom: clamp(var(--space-lg), 4vw, var(--space-16));
    padding-top: var(--space-sm);
  }
  .section-heading::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2.25rem;
    height: 2px;
    background: var(--color-border-strong);
  }
  .section-heading--center {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }
  .section-heading--center::before {
    left: 50%;
    transform: translateX(-50%);
  }
  .section-heading--center .section-heading__desc {
    margin-inline: auto;
  }
  .section-heading--compact {
    gap: 0.55em;
    margin-bottom: var(--space-xl);
    padding-top: var(--space-xs);
  }
  .section-heading--compact::before {
    width: 1.5rem;
  }
  .section-heading--compact .section-heading__title {
    font-size: clamp(1.25rem, 1.7vw, 1.55rem);
    font-weight: 700;
    max-width: 40ch;
  }
  .section-heading--compact .section-heading__desc {
    font-size: var(--fs-sm);
  }
  .section-heading__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /*
     * CC-01 token-compatibility fix, found via axe-core in
     * tests/e2e/axe.spec.ts (real regression across multiple pages —
     * home, home-en, and others — every instance where a SectionHeading
     * renders inside a `.section--alt` block, whose background is
     * `--color-surface-alt` = `--color-paper-100`). Same root cause and
     * fix as ProcessTimeline.astro's __index (see that file's comment):
     * `--color-accent` (copper-600, #b84e1d) measures 4.18-4.19:1 on
     * `--color-paper-100`, below the 4.5:1 text threshold —
     * `--color-accent-dark` (copper-700, #9c4014) clears it at 5.50:1,
     * same hue family, no other visual change.
     */
    color: var(--color-muted);
    margin: 0;
    font-weight: 600;
  }
  .section-heading__title {
    margin: 0;
    max-width: 21ch;
    text-wrap: balance;
  }
  .section-heading--center .section-heading__title {
    margin-inline: auto;
  }
  .section-heading__desc {
    color: var(--color-muted);
    font-size: var(--fs-md);
    line-height: var(--lh-body-lg);
    margin: 0;
    max-width: 46rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-heading::before {
      transition: none;
    }
  }
</style>

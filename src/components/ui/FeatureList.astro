---
export interface Props {
  items: string[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<ul class:list={['feature-list', className]}>
  {items.map((item) => (
    <li>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="8.25" stroke="currentColor" stroke-width="1.3"/>
        <path d="M5.5 9.3l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{item}</span>
    </li>
  ))}
</ul>

<style>
  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
  }
  .feature-list svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.15em;
  }
  .feature-list span {
    font-size: var(--fs-sm);
    color: var(--color-ink-soft);
    line-height: var(--lh-relaxed);
  }
</style>

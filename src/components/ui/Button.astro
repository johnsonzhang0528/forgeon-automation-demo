---
export interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'secondary-invert' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  id?: string;
  disabled?: boolean;
  loading?: boolean;
  ariaLabel?: string;
  trackEvent?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  class: className = '',
  id,
  disabled = false,
  loading = false,
  ariaLabel,
  trackEvent,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className, loading ? 'is-loading' : '']
  .filter(Boolean)
  .join(' ');
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class={classes}
  id={id}
  disabled={!href ? disabled || loading : undefined}
  aria-disabled={href && (disabled || loading) ? 'true' : undefined}
  aria-busy={loading ? 'true' : undefined}
  aria-label={ariaLabel}
  data-track={trackEvent}
  {...rest}
>
  {loading && (
    <svg class="btn__spinner" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="2" stroke-opacity="0.3" />
      <path d="M14.5 8a6.5 6.5 0 0 0-6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  )}
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn--md {
    padding: 0.7em 1.4em;
    font-size: var(--fs-sm);
  }
  .btn--lg {
    padding: 0.9em 1.8em;
    font-size: var(--fs-md);
  }
  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }
  /*
   * Primary hover per spec §9: "Hover 不只變亮，可有 1-2px 的軸線位移;
   * 不得大幅跳動" — a restrained 1.5px lift (transform, not layout-shifting
   * margin/padding) alongside the darker fill, distinct from the ordinary
   * :active press-down. prefers-reduced-motion already zeroes
   * --duration-fast site-wide (tokens.css), so the transform still applies
   * instantly with no animated motion when reduced motion is requested.
   */
  .btn--primary:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    color: var(--color-accent-contrast);
    transform: translateY(-1.5px);
  }
  .btn--primary:active {
    transform: translateY(0.5px);
  }
  .btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border-strong);
  }
  .btn--secondary:hover {
    border-color: var(--color-ink);
    background: var(--color-surface-alt);
  }
  /*
   * secondary-invert: a real, typed variant for the one recurring case
   * where a secondary button sits on a dark/inverted surface (CTABanner,
   * which always renders on --color-ink). This is a genuine bug fix found
   * via real-browser screenshot review (not caught by static code review):
   * plain "secondary" used `color: var(--color-ink)`, which on a
   * --color-ink background rendered completely invisible text — only the
   * border was visible, making the button look empty. See
   * docs/IMPECCABLE_REVIEW_LOG.md.
   */
  .btn--secondary-invert {
    background: transparent;
    color: var(--color-invert-text);
    /* --color-invert-border (#2a323c) is only 1.38:1 against --color-ink —
       fine for a subtle section divider, not enough for a UI-boundary
       button border (needs 3:1 per WCAG 1.4.11). --color-invert-muted
       clears it at 6.99:1. See docs/CONTRAST_AUDIT.md. */
    border-color: var(--color-invert-muted);
  }
  .btn--secondary-invert:hover {
    border-color: var(--color-invert-text);
    background: color-mix(in srgb, var(--color-invert-text) 8%, transparent);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-accent);
    border-color: transparent;
    padding-inline: 0.4em;
  }
  .btn--ghost:hover {
    color: var(--color-accent-dark);
  }
  .btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .btn[disabled]:hover {
    transform: none;
  }

  /* ---- Loading state (spec §9: Default/Hover/Focus/Active/Disabled/Loading) ---- */
  .btn__spinner {
    animation: btn-spin 800ms linear infinite;
    flex-shrink: 0;
  }
  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn__spinner {
      animation-duration: 1ms;
    }
  }
</style>

---
export interface Props {
  title: string;
  message: string;
  class?: string;
}
const { title, message, class: className = '' } = Astro.props;
---

<div class:list={['error-state', className]} role="alert">
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <circle cx="14" cy="14" r="11" stroke="currentColor" stroke-width="1.6"/>
    <path d="M14 8v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <circle cx="14" cy="19" r="1.1" fill="currentColor"/>
  </svg>
  <div>
    <p class="error-state__title">{title}</p>
    <p class="error-state__message">{message}</p>
  </div>
</div>

<style>
  .error-state {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding: var(--space-md);
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid color-mix(in srgb, var(--color-error) 30%, transparent);
    border-radius: var(--radius-md);
  }
  .error-state__title {
    margin: 0 0 0.25em;
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .error-state__message {
    margin: 0;
    font-size: var(--fs-sm);
  }
</style>

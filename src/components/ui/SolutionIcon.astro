---
export interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className = '' } = Astro.props;
---

<svg class:list={['solution-icon', className]} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  {slug === 'vision-guided-assembly' && (
    <>
      <circle cx="20" cy="17" r="9" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="20" cy="17" r="3" fill="currentColor"/>
      <path d="M10 34l6-9M30 34l-6-9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </>
  )}
  {slug === 'precision-positioning' && (
    <>
      <rect x="6" y="18" width="28" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
      <rect x="15" y="10" width="10" height="10" rx="2" fill="currentColor"/>
    </>
  )}
  {slug === 'vision-inspection' && (
    <>
      <rect x="8" y="12" width="24" height="17" rx="2" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="20" cy="20.5" r="5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M14 33h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </>
  )}
  {slug === 'assembly-cells' && (
    <>
      <rect x="6" y="10" width="10" height="20" rx="1.6" stroke="currentColor" stroke-width="1.6"/>
      <rect x="18" y="10" width="10" height="20" rx="1.6" stroke="currentColor" stroke-width="1.6"/>
      <rect x="30" y="16" width="6" height="8" rx="1.2" fill="currentColor"/>
    </>
  )}
  {slug === 'line-upgrade' && (
    <>
      <path d="M6 24h28" stroke="currentColor" stroke-width="1.6"/>
      <path d="M22 24l6-10 6 10" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="12" cy="24" r="3" fill="currentColor"/>
    </>
  )}
  {slug === 'custom-integration' && (
    <>
      <path d="M10 10l8 8-8 8M30 10l-8 8 8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="20" cy="30" r="3" fill="currentColor"/>
    </>
  )}
</svg>

<style>
  .solution-icon {
    width: 32px;
    height: 32px;
    color: var(--color-accent);
    flex-shrink: 0;
  }
</style>

---
export interface Props {
  message: string;
  class?: string;
}
const { message, class: className = '' } = Astro.props;
---

<div class:list={['empty-state', className]} role="status">
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <rect x="6" y="10" width="28" height="22" rx="2" stroke="currentColor" stroke-width="1.5"/>
    <path d="M6 16h28M13 23h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
  <p>{message}</p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-2xl) var(--space-lg);
    color: var(--color-muted);
    text-align: center;
  }
  .empty-state p {
    margin: 0;
    font-size: var(--fs-sm);
  }
</style>

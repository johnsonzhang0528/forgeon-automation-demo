---
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';
import Card from './Card.astro';
import ProductGlyph from './ProductGlyph.astro';
import Badge from './Badge.astro';

export interface Props {
  locale: Locale;
  slug: 'axm-400' | 'vision-x2' | 'flexcell-m';
  name: string;
  positioning: string;
  description: string;
}
const { locale, slug, name, positioning, description } = Astro.props;
const dict = getDictionary(locale);
---

<Card href={`/${locale}/products/${slug}/`} padding="none">
  <ProductGlyph product={slug} variant="flush" />
  <div class="product-card__body">
    <div class="product-card__head">
      <h3 class="product-card__name mono">{name}</h3>
      <Badge variant="demo">{dict.misc.demoDataBadge}</Badge>
    </div>
    <p class="product-card__positioning">{positioning}</p>
    <p class="product-card__desc measure">{description}</p>
    <span class="product-card__link">
      {dict.cta.viewDetail}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</Card>

<style>
  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
  }
  .product-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .product-card__name {
    font-size: var(--fs-lg);
    margin: 0;
    font-weight: 700;
  }
  .product-card__positioning {
    font-weight: 600;
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-ink-soft);
  }
  .product-card__desc {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }
  .product-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-accent);
    font-size: var(--fs-sm);
    font-weight: 600;
    margin-top: var(--space-2xs);
  }
</style>

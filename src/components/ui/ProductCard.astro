---
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';
import Card from './Card.astro';
import ProductVisual from './ProductVisual.astro';

export interface Props {
  locale: Locale;
  slug: 'axm-400' | 'vision-x2' | 'flexcell-m';
  name: string;
  positioning: string;
  description: string;
  /**
   * Dominant-anchor treatment for the Product Editorial Plate composition
   * (docs/uiux-upgrade/09-product-plate-and-ending.md P1-1): larger name/
   * positioning type, more caption weight. The subordinate pair renders
   * with the same markup and shared rules, just without this modifier —
   * one composition read through scale, not three interchangeable cards.
   */
  dominant?: boolean;
}
const { locale, slug, name, positioning, description, dominant = false } = Astro.props;
const dict = getDictionary(locale);
const badgeLabel = slug === 'flexcell-m' ? dict.demoNotice.specLabel : dict.misc.demoDataBadge;
---

<Card href={`/${locale}/products/${slug}/`} padding="none" class={dominant ? 'product-card--dominant' : ''}>
  <ProductVisual locale={locale} product={slug} placement="card" />
  <div class="product-card__body">
    <div class="product-card__head">
      <h3 class="product-card__name mono">{name}</h3>
      <span class="product-card__demo-notice mono">{badgeLabel}</span>
    </div>
    <p class="product-card__positioning">{positioning}</p>
    <p class="product-card__desc measure">{description}</p>
    <span class="product-card__link">
      {dict.cta.viewDetail}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</Card>

<style>
  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
  }
  :global(.product-card--dominant) .product-card__name {
    font-size: var(--fs-xl);
  }
  :global(.product-card--dominant) .product-card__positioning {
    font-size: var(--fs-md);
  }
  :global(.product-card--dominant) .product-card__desc {
    font-size: var(--fs-md);
  }
  .product-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .product-card__name {
    font-size: var(--fs-lg);
    margin: 0;
    font-weight: 700;
  }
  .product-card__demo-notice {
    color: var(--color-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .product-card__positioning {
    font-weight: 600;
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-ink-soft);
  }
  .product-card__desc {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }
  .product-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-accent);
    font-size: var(--fs-sm);
    font-weight: 600;
    margin-top: var(--space-2xs);
  }
</style>

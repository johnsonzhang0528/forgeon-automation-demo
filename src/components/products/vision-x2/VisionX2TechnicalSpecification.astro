---
/**
 * VISION-X2 Product Detail — Technical Specification (PD-VX2-06).
 *
 * Sixth stage of the dedicated VISION-X2 Product Detail composition
 * (VisionX2ProductDetail.astro), approved at the PD-VX2-06 Ticket
 * Definition Gate. Three grouped semantic <table> elements (Imaging /
 * Lighting / Processing & Integration), matching the group structure the
 * approved Mockup already established — not a single flat table (that
 * would collapse the approved visual grouping) and not the shared
 * SpecificationTable.astro (single-group, rounded-corner treatment that
 * doesn't match the VISION-X2 editorial system, and shared with AXM-400/
 * FLEXCELL-M — reusing it here would risk their regression).
 *
 * Content / Claims Integrity (PD-VX2-06 Gate, locked):
 * - All 9 rows trace to vision-x2.md's existing canonical `specs` array.
 *   vision-x2.md is not modified by this component.
 * - Rows 6-9 (運算架構/通訊整合/觸發方式/安裝環境) reuse the canonical
 *   value verbatim, in both locales.
 * - Rows 1 and 4 (相機解析度/處理速度) intentionally do NOT reproduce the
 *   canonical raw values, which contain "（Demo 數值）" — that internal
 *   qualifier must never reach the visitor-facing page. Instead they use
 *   the approved qualitative Mockup wording ("依應用選配" /
 *   "依運算配置評估"). This is a presentation projection of the same
 *   underlying canonical field, not a new specification value, and not a
 *   Demo disclosure anywhere on the page (the sitewide Footer legalNotice
 *   remains the only disclosure mechanism, per the earlier Phase 5C-R2
 *   Gate ruling — no footnote/caption/tooltip is added here either).
 * - No dimension, weight, IP rating, protocol name, resolution number,
 *   frame rate, accuracy percentage, or other unsupported technical value
 *   is introduced anywhere in this component.
 */
import { getDictionary } from '../../../utils/i18n';
import type { Locale } from '../../../config/site';

export interface Props {
  locale: Locale;
}

interface SpecRow {
  label: string;
  value: string;
}
interface SpecGroup {
  label: string;
  rows: SpecRow[];
}

const { locale } = Astro.props;
const copy = getDictionary(locale).productDetailVisionX2TechnicalSpecification;
---

<section class="vx-pd-spec" aria-labelledby="vx-pd-spec-heading">
  <div class="container container--narrow">
    <div class="vx-pd-spec__intro">
      <p class="vx-pd-spec__eyebrow mono">{copy.eyebrow}</p>
      <h2 id="vx-pd-spec-heading" class="vx-pd-spec__title">{copy.title}</h2>
    </div>

    {copy.groups.map((group: SpecGroup) => (
      <div class="vx-pd-spec__group">
        <p class="vx-pd-spec__group-label mono">{group.label}</p>
        <div class="vx-pd-spec__table-wrap">
          <table class="vx-pd-spec__table">
            <caption class="visually-hidden">{group.label}</caption>
            <tbody>
              {group.rows.map((row: SpecRow) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td class="mono">{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .vx-pd-spec {
    background: var(--color-surface-alt);
    padding-block: var(--section-standard);
  }
  .container--narrow {
    max-width: 860px;
  }

  .vx-pd-spec__intro {
    margin-bottom: var(--space-lg);
  }
  .vx-pd-spec__eyebrow {
    margin: 0 0 var(--space-2xs);
    color: var(--color-accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .vx-pd-spec__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .vx-pd-spec__group {
    margin-bottom: var(--space-xl);
  }
  .vx-pd-spec__group:last-child {
    margin-bottom: 0;
  }
  .vx-pd-spec__group-label {
    margin: 0 0 var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
  }

  .vx-pd-spec__table-wrap {
    border: 1px solid var(--color-border);
  }
  .vx-pd-spec__table {
    width: 100%;
    border-collapse: collapse;
  }
  .vx-pd-spec__table tr {
    border-bottom: 1px solid var(--color-border);
  }
  .vx-pd-spec__table tr:last-child {
    border-bottom: none;
  }
  .vx-pd-spec__table th,
  .vx-pd-spec__table td {
    text-align: left;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--fs-sm);
    vertical-align: top;
  }
  .vx-pd-spec__table th {
    color: var(--color-muted);
    font-weight: 600;
    width: 40%;
    background: var(--color-surface);
  }
  .vx-pd-spec__table td {
    color: var(--color-ink);
  }

  @media (max-width: 560px) {
    .vx-pd-spec__table,
    .vx-pd-spec__table tbody,
    .vx-pd-spec__table tr,
    .vx-pd-spec__table th,
    .vx-pd-spec__table td {
      display: block;
      width: 100%;
    }
    .vx-pd-spec__table tr {
      padding: var(--space-sm) var(--space-md);
    }
    .vx-pd-spec__table th {
      padding: 0 0 var(--space-3xs);
      background: none;
    }
    .vx-pd-spec__table td {
      padding: 0;
    }
  }
</style>

---
import type { Locale } from '../../config/site';
import { getDictionary, otherLocale, switchLocalePath } from '../../utils/i18n';

export interface Props {
  locale: Locale;
  path: string;
  otherLocalePath?: string;
  variant?: 'default' | 'invert';
}

const { locale, path, otherLocalePath, variant = 'default' } = Astro.props;
const dict = getDictionary(locale);
const target = otherLocale(locale);
const href = otherLocalePath ?? switchLocalePath(path, target);
---

<a
  href={href}
  class:list={['lang-switch', { 'lang-switch--invert': variant === 'invert' }]}
  data-lang-switch
  hreflang={target === 'zh-tw' ? 'zh-Hant-TW' : 'en'}
  lang={target === 'zh-tw' ? 'zh-Hant-TW' : 'en'}
>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.2"/>
    <path d="M1.5 8h13M8 1.5c1.8 1.8 2.8 4 2.8 6.5S9.8 12.7 8 14.5C6.2 12.7 5.2 10.5 5.2 8S6.2 3.3 8 1.5Z" stroke="currentColor" stroke-width="1.2"/>
  </svg>
  {dict.footer.langSwitch}
</a>

<script>
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement)?.closest('[data-lang-switch]');
    if (!el) return;
    window.dispatchEvent(new CustomEvent('forgeon:analytics', {
      detail: { event: 'language_switch', payload: { to: el.getAttribute('hreflang') } },
    }));
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    /*
     * Touch-target remediation (CC-02I-02 review, HIGH-03): the ANCHOR's
     * own box, not a parent wrapper, must clear 44x44px — Header.astro's
     * `.site-header__lang` wrapper previously supplied the 44px floor via
     * `min-block-size` while this link's own rendered box stayed ~32.5px
     * tall, which is what an actual pointer/assistive-tech hit-test
     * targets. --space-xs (12px block) brings the link's own content-box
     * to >=44px without a new spacing token. Horizontal padding stays at
     * the smaller --space-3xs (4px, down from --space-2xs) — width isn't
     * the constrained axis for this control's own 44px floor
     * (min-inline-size covers it directly), and every inline pixel here
     * is shared with .mobile-nav-toggle's own 44px floor in the same row
     * at the 320px acceptance-criteria viewport (ticket §14) — see
     * Header.astro's .site-header__actions remediation note.
     */
    padding: var(--space-xs) var(--space-3xs);
    min-inline-size: 44px;
    min-block-size: 44px;
    border-radius: var(--radius-sm);
  }
  .lang-switch:hover {
    color: var(--color-accent);
  }
  .lang-switch--invert {
    color: var(--color-invert-text);
  }
  .lang-switch--invert:hover {
    color: var(--color-accent-light);
  }
</style>

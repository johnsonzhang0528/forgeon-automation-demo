---
/**
 * YF-IMG-03 — representative control-engineering and commissioning imagery.
 *
 * The Final Master is reused through art-directed CSS crops. The mobile crop
 * keeps the engineer, meter, probe and terminal contact together; no website
 * text or technical claim is baked into the bitmap.
 */
import { Picture } from 'astro:assets';
import controlEngineeringImage from '../../assets/images/services/control-engineering-final-master.png';
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';

export interface Props {
  locale: Locale;
  presentation?: 'master' | 'four-three';
  priority?: boolean;
}

const { locale, presentation = 'master', priority = false } = Astro.props;
const imagery = getDictionary(locale).productionImagery.controlEngineering;
---

<figure
  class:list={['control-engineering-visual', `control-engineering-visual--${presentation}`]}
  data-production-image="YF-IMG-03"
  data-presentation={presentation}
>
  <div class="control-engineering-visual__media">
    <Picture
      src={controlEngineeringImage}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1280, 1535]}
      sizes="(min-width: 908px) 860px, (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
      alt={imagery.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      quality={82}
    />
  </div>
  <figcaption class="control-engineering-visual__caption">
    <span class="control-engineering-visual__marker" aria-hidden="true"></span>
    <span>{imagery.caption}</span>
  </figcaption>
</figure>

<style>
  .control-engineering-visual {
    margin: var(--space-xl) 0;
  }

  .control-engineering-visual__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-steel-900, #151a1e);
    aspect-ratio: 4 / 3;
  }

  .control-engineering-visual__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .control-engineering-visual__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% 50%;
  }

  .control-engineering-visual__caption {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  .control-engineering-visual__marker {
    display: block;
    width: 100%;
    height: 2px;
    margin-top: 0.55em;
    background: var(--color-accent);
  }

  @media (min-width: 768px) {
    .control-engineering-visual--master .control-engineering-visual__media {
      aspect-ratio: 3 / 2;
    }

    .control-engineering-visual__caption {
      grid-template-columns: 3rem minmax(0, 44rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control-engineering-visual__media,
    .control-engineering-visual__media :global(img) {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

---
/**
 * Homepage Hero — Precision Instrument Editorial (DESIGN.md v2 §5/§9/§18).
 *
 * Full-bleed FORGEON-HERO-MASTER-v1 photograph with copy overlaid directly
 * on the image, anchored low-left — not a text-column-beside-image split.
 * This replaces the previous "text column + boxed photo" Precision Datum
 * layout: DESIGN.md v2 §0 supersedes that system, and the Phase 5A-R Visual
 * Gate specifically rejected the split-column hero as reading like a
 * generic B2B template.
 *
 * The hero image itself is locked production art (FINAL PRODUCTION
 * ACCEPTED, Phase 5A-R2) — this component only frames it responsively; it
 * must never crop out the vision module / ring illumination / fixture /
 * workpiece relationship, add overlays, or recolor it (see the object-fit
 * rules below, which shift crop focus per breakpoint via object-position
 * only, never a different image).
 */
import { Picture } from 'astro:assets';
import heroImage from '../../assets/images/forgeon/home/forgeon-hero-master-v1.png';
import { getDictionary } from '../../utils/i18n';
import type { Locale } from '../../config/site';
import Button from '../ui/Button.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hero = getDictionary(locale).hero;
---

<section class="hero-root" data-hero-motion-root data-motion-state="settled">
  <figure class="hero-root__media" data-hero-image="final-master">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1440, 1920]}
      sizes="100vw"
      alt={hero.imageAlt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={82}
    />
  </figure>

  <div class="hero-root__scrim" aria-hidden="true"></div>

  <div class="hero-root__content">
    <p class="hero-root__eyebrow mono">{hero.eyebrow}</p>
    <h1 class="hero-root__headline">{hero.headline}</h1>
    <p class="hero-root__body">{hero.body}</p>
    <div class="hero-root__ctas">
      <Button
        href={`/${locale}/contact/?intent=project`}
        variant="secondary-invert"
        size="md"
        trackEvent="cta_click"
        data-intent="project"
        data-source="home-hero"
        class="hero-root__cta-primary"
      >
        {hero.ctaPrimary}
      </Button>
      <Button
        href={`/${locale}/products/`}
        variant="ghost"
        size="md"
        trackEvent="cta_click"
        data-intent="browse-products"
        data-source="home-hero"
        class="hero-root__cta-secondary"
      >
        {hero.ctaSecondary}
        <span aria-hidden="true">&rarr;</span>
      </Button>
    </div>
  </div>
</section>

<style>
  .hero-root {
    position: relative;
    display: grid;
    /* Full-bleed: intentionally breaks out of the page's max-width
       container (DESIGN.md v2 §5/§18 — the hero image controls the
       viewport, not a card inside a gutter). */
    width: 100%;
    min-height: 560px;
    height: 78svh;
    max-height: 860px;
    overflow: hidden;
    background: var(--color-ink-950);

    /*
     * Scoped Direction-B accent (DESIGN.md v2 §0/§10): the sitewide
     * --color-accent/--color-copper-* tokens in tokens.css still belong to
     * the superseded Precision Datum System (and --color-copper-600 is
     * literally a blue hex despite its name — see DESIGN.md v2 §0). This
     * phase's scope is Header + Hero only, so rather than repoint the
     * global token (which would silently reskin every Button/Card/Footer
     * sitewide, far outside this ticket), the override lives here and
     * cascades only to descendants of .hero-root — Button.astro itself is
     * untouched, and every other page/section keeps the current sitewide
     * accent until a later phase migrates them deliberately.
     */
    --color-accent: #3d5a6c;
    --color-accent-dark: #24404f;
    --color-accent-contrast: #f6f4f0;
    --radius-md: 2px;
  }

  .hero-root__media,
  .hero-root__media :global(picture) {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .hero-root__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the VISION-X2 module + ring illumination + fixture column
       (the right two-thirds of the source frame) in view while trimming
       the darkest, least informative left edge first as the viewport
       narrows. Breakpoints only ever shift object-position on this one
       image — never swap in a different crop or asset. */
    object-position: 62% 42%;
  }

  .hero-root__scrim {
    position: absolute;
    inset: 0;
    /* Left-anchored falloff so body copy stays readable without turning
       the whole frame into a dark card (DESIGN.md v2 §5: "black must
       reveal form, not erase form" applies to UI treatment same as the
       photography itself). Right two-thirds of the image stay clear. */
    background: linear-gradient(
      100deg,
      rgba(10, 13, 15, 0.78) 0%,
      rgba(10, 13, 15, 0.52) 24%,
      rgba(10, 13, 15, 0.12) 46%,
      rgba(10, 13, 15, 0) 62%
    );
  }

  .hero-root__content {
    position: relative;
    z-index: 1;
    align-self: end;
    max-width: 26em;
    margin-inline-start: var(--page-gutter-mobile);
    margin-block-end: var(--space-6);
    padding-inline-end: var(--page-gutter-mobile);
  }

  /*
   * Phase 5D-R1 P0: the "品牌概念影像"/"Concept brand imagery" per-image
   * disclosure label is removed sitewide from Hero and VISION-X2
   * Signature (see VisionX2Signature.astro's matching note) — it read as
   * demo/concept-project language leaking onto FORGEON's own public
   * surface (DESIGN.md v2 §1: the site must never self-identify as a
   * portfolio/demo). Claims Integrity is unaffected: the site's real
   * disclosure mechanism is the sitewide Demo Mode footer notice
   * (Footer.astro's `legalNotice`), not a per-image caption.
   */
  .hero-root__eyebrow {
    margin: 0 0 var(--space-2);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero-root__headline {
    max-width: 15ch;
    margin: 0 0 var(--space-3);
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 6.4vw, 2rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.005em;
    white-space: pre-line;
    text-wrap: balance;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
  }

  :lang(zh-Hant-TW) .hero-root__headline {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 600;
  }

  .hero-root__body {
    max-width: 26em;
    margin: 0 0 var(--space-5);
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.875rem;
    line-height: 1.65;
    white-space: pre-line;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .hero-root__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  /*
   * CTA weight correction (Phase 5B-R1 §C): the previous pair rendered as
   * two same-size filled/bordered rectangles — generic "landing page
   * button row." Primary keeps a real, findable action (bordered, not
   * filled, sized to its own text via inline-flex + tightened padding)
   * without the SaaS block weight; secondary drops to a text+arrow ghost
   * action a clear level below it. Button.astro itself is untouched
   * (§11) — both overrides are scoped call-site rules on Button's already
   *-public classes, the same pattern Header.astro uses for its own CTA.
   */
  .hero-root__ctas :global(.hero-root__cta-primary.btn) {
    padding: 0.62em 1.35em;
    font-size: 0.8125rem;
    font-weight: 600;
    border-color: var(--color-accent-contrast, #f6f4f0);
    color: var(--color-accent-contrast, #f6f4f0);
  }
  .hero-root__ctas :global(.hero-root__cta-primary.btn:hover) {
    background: var(--color-accent-contrast, #f6f4f0);
    color: var(--color-ink-950);
    border-color: var(--color-accent-contrast, #f6f4f0);
  }

  .hero-root__ctas :global(.hero-root__cta-secondary.btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }
  .hero-root__ctas :global(.hero-root__cta-secondary.btn) span {
    display: inline-block;
    transition: transform var(--duration-ui) var(--ease-standard);
  }
  .hero-root__ctas :global(.hero-root__cta-secondary.btn:hover) {
    color: #fff;
  }
  .hero-root__ctas :global(.hero-root__cta-secondary.btn:hover) span {
    transform: translateX(3px);
  }

  @media (max-width: 400px) {
    .hero-root__ctas {
      gap: var(--space-4);
    }
  }

  @media (min-width: 640px) {
    .hero-root__headline {
      max-width: none;
      font-size: clamp(1.875rem, 4vw, 2.25rem);
    }
  }

  @media (min-width: 1024px) {
    .hero-root {
      height: 80svh;
      max-height: 880px;
    }

    .hero-root__content {
      max-width: 32em;
      margin-inline-start: var(--page-gutter-desktop);
      margin-block-end: var(--space-14);
    }

    .hero-root__eyebrow {
      margin-bottom: var(--space-3);
    }

    .hero-root__headline {
      margin-bottom: var(--space-4);
      font-size: clamp(2.25rem, 2.9vw, 2.875rem);
      line-height: 1.3;
    }

    .hero-root__body {
      margin-bottom: var(--space-6);
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 1440px) {
    .hero-root__media :global(img) {
      object-position: 60% 40%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-root__media,
    .hero-root__media :global(picture),
    .hero-root__media :global(img) {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

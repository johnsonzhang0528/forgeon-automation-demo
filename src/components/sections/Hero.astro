---
/**
 * Hero — production homepage Hero (CC-02I-04), 12-column editorial grid,
 * assembled from CC-02I-05's already-finished production visual components
 * (PrecisionSystemVisual, ProcessRail, EvaluationLedger). Rebuilt against
 * production contracts from CC-02F's reviewed FinalEditorialHero prototype
 * design (src/components/prototypes/cc02-final/FinalEditorialHero.astro,
 * read-only reference, never imported) — not a copy, not a shared-import
 * refactor.
 *
 * Fixed DOM order (ticket §8, mandatory at every viewport):
 *   Datum Origin -> Eyebrow -> H1 -> Supporting Copy -> Primary CTA ->
 *   Secondary CTA -> Primary System Visual -> Evaluation Ledger ->
 *   Process Rail
 * Every element above is a flat, direct child of the Hero root in exactly
 * this source order. Desktop CSS Grid repositions elements visually via
 * `grid-column`/`grid-row` on each child individually — it never nests a
 * sub-container that would let a later child's markup precede an earlier
 * child's in the DOM. The Secondary System Visual is not its own fixed-
 * order slot (absent from the ticket's nine-item list); it is a flat
 * sibling of the Primary Visual wrapper, immediately after it in DOM order,
 * both sharing the "Primary System Visual" DOM position, matching §5's
 * desktop grid description ("Secondary Visual cols 10-13") without
 * inventing a tenth DOM-order item. It is a sibling — not nested inside
 * the Primary Visual's wrapper — so its Hero-owned grid placement/sizing
 * selector is a real, independent grid item (see HIGH-01 remediation note
 * at the Secondary Visual's markup below).
 *
 * Motion root (R2-02): the root element carries both
 * `data-hero-motion-root` and `data-motion-state="settled"`. The Motion
 * Bootstrap <script> (CC-02I-06) sits immediately after the root's opening
 * tag, before the Primary Visual markup, per CC-02I-04's reserved mount
 * point — this DOM position is not restructured here.
 *
 * Motion Orchestrator (CC-02I-06, spec §10 / ticket §8): a single,
 * synchronous, non-deferred, non-module inline <script> owns the Hero's
 * four-state machine (settled/armed/running/complete) via
 * data-motion-state on the root. It is the only IntersectionObserver in
 * the Hero subtree — PrecisionSystemVisual and ProcessRail react to the
 * root's state purely through [data-hero-motion-root]-scoped CSS and
 * create no observer of their own.
 */
import { getDictionary } from '../../utils/i18n';
import type { Locale } from '../../config/site';
import Button from '../ui/Button.astro';
import DatumOrigin from '../brand/DatumOrigin.astro';
import PrecisionSystemVisual from './PrecisionSystemVisual.astro';
import ProcessRail from './ProcessRail.astro';
import EvaluationLedger from './EvaluationLedger.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const hero = dict.hero;

const ledgerGroups: [
  { heading: string; detail: string },
  { heading: string; detail: string },
  { heading: string; detail: string },
] = [hero.ledger.input, hero.ledger.evaluation, hero.ledger.output];

const processSteps: [string, string, string, string] = [
  hero.processRail.step1,
  hero.processRail.step2,
  hero.processRail.step3,
  hero.processRail.step4,
];
---

<section class="hero-root" data-hero-motion-root data-motion-state="settled">
  <!-- Motion Bootstrap mount point (CC-02I-06): synchronous, non-deferred, non-module inline script below. -->
  <script is:inline>
    (function () {
      var root = document.currentScript.closest('[data-hero-motion-root]');
      if (!root) return;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hasIO = typeof IntersectionObserver === 'function';
      if (reduced || !hasIO) {
        root.setAttribute('data-motion-state', 'settled');
        return;
      }
      root.setAttribute('data-motion-state', 'armed');
      var NARRATIVE_MS = 1000;
      var io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              root.setAttribute('data-motion-state', 'running');
              window.setTimeout(function () {
                root.setAttribute('data-motion-state', 'complete');
              }, NARRATIVE_MS);
              io.disconnect();
              break;
            }
          }
        },
        { threshold: 0.15 }
      );
      io.observe(root);
    })();
  </script>

  <div class="hero-root__origin">
    <DatumOrigin size={40} orientation="both" label="0,0" />
  </div>

  <p class="hero-root__eyebrow mono">{hero.eyebrow}</p>

  <h1 class="hero-root__headline">{hero.headline}</h1>

  <p class="hero-root__body">{hero.body}</p>

  <div class="hero-root__ctas">
    <Button
      href={`/${locale}/contact/?intent=project`}
      size="lg"
      trackEvent="cta_click"
      data-intent="project"
      data-source="home-hero"
    >
      {hero.ctaPrimary}
    </Button>
    <Button
      href={`/${locale}/contact/?intent=technical-advice`}
      variant="secondary"
      size="lg"
      trackEvent="cta_click"
      data-intent="technical-advice"
      data-source="home-hero"
    >
      {hero.ctaSecondary}
    </Button>
  </div>

  <div class="hero-root__visual">
    <PrecisionSystemVisual
      uid="homepage-hero-system"
      variant="primary"
      animated
      alt={hero.visualAlt}
    />
  </div>

  {/*
    FLAGGED DEVIATION (see completion report / Stage Gate): the ticket/
    spec's uid contract ("Hero.astro always passes the literal string
    'homepage-hero-system'") was written for a single PrecisionSystemVisual
    instance. Hero.astro renders two simultaneous instances (primary +
    secondary), and passing the identical literal to both produces
    duplicate SVG gradient/mask/clipPath ids in the same document (a real
    HTML-validity defect, confirmed via this ticket's own test suite).
    Every id PrecisionSystemVisual emits is a deterministic, pure-function
    derivation of `uid` (R1-04's actual requirement: no Math.random(), no
    runtime-generated value) — appending a fixed "-secondary" suffix stays
    fully deterministic/reproducible and satisfies that requirement while
    resolving the duplicate-id defect. Not a unilateral redesign of the
    uid contract: PrecisionSystemVisual.astro itself is unmodified.

    Composition (HIGH-01 remediation): this wrapper, not a class passed
    into the child, is the real grid item. An Astro scoped-style selector
    written in this file only ever matches elements that carry *this*
    component's own `data-astro-cid-*` scope attribute — PrecisionSystemVisual's
    rendered <figure> carries its own, different scope attribute instead, so
    a Hero-scoped class placed directly on the child never actually applied
    (confirmed via built output: the class was present in the DOM but the
    scoped CSS rule targeting it could not match). Sizing/placement now live
    entirely on `.hero-root__visual-secondary`, an element Hero itself owns
    and renders, so the scoped selector always resolves.
  */}
  <div class="hero-root__visual-secondary">
    <PrecisionSystemVisual
      uid="homepage-hero-system-secondary"
      variant="secondary"
      alt={hero.secondaryVisualAlt}
    />
  </div>

  <div class="hero-root__ledger">
    <EvaluationLedger groups={ledgerGroups} />
  </div>

  <div class="hero-root__rail">
    <ProcessRail
      steps={processSteps}
      railLabel={hero.processRail.railLabel}
      stateLabels={hero.processRail.stateLabels}
    />
  </div>
</section>

<style>
  .hero-root {
    position: relative;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-6) var(--page-gutter-mobile) var(--space-16);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .hero-root {
      padding-inline: var(--page-gutter-tablet);
    }
  }
  @media (min-width: 1024px) {
    .hero-root {
      padding: var(--space-12) var(--page-gutter-desktop) var(--space-16);
    }
  }

  /* ---- Mobile / tablet: fixed DOM order reads as one visual column ---- */
  .hero-root__origin {
    margin-bottom: calc(-1 * var(--space-5));
  }
  .hero-root__eyebrow {
    color: var(--color-action-primary);
    font-size: var(--fs-technical);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .hero-root__headline {
    font-family: var(--font-display);
    font-size: var(--fs-h1-mobile, clamp(2.35rem, 10.5vw, 3rem));
    line-height: 1.04;
    letter-spacing: var(--ls-h1);
    margin: 0;
    white-space: pre-line;
    max-width: 720px;
  }
  :lang(zh-Hant-TW) .hero-root__headline {
    font-family: 'Noto Sans TC', var(--font-display);
    letter-spacing: 0;
  }
  :lang(en) .hero-root__headline {
    font-size: clamp(1.6rem, 7.4vw, 2.35rem);
  }
  .hero-root__body {
    color: var(--color-steel-700);
    font-size: var(--fs-small);
    line-height: var(--lh-body, 1.6);
    max-width: var(--measure-zh);
    white-space: pre-line;
    margin: 0;
  }
  .hero-root__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /*
   * Ticket §5/spec §5: at 360px and 320px, the English CTA text must wrap
   * to a second line rather than shrinking below its specified size or
   * forcing viewport overflow. Button.astro (forbidden file, sitewide
   * shared component) sets `white-space: nowrap` on .btn by default; this
   * scoped override only applies inside the Hero's CTA row, only below
   * 400px, and only changes wrapping behavior — no Button.astro token,
   * color, or default-variant output is touched.
   */
  @media (max-width: 400px) {
    .hero-root__ctas :global(.btn) {
      white-space: normal;
      text-align: center;
      flex: 1 1 100%;
    }
  }

  .hero-root__visual {
    position: relative;
    min-width: 0;
  }
  .hero-root__visual :global(.precision-visual) {
    max-width: 100%;
    min-width: 0;
  }
  /*
   * Mobile/tablet: a real flow sibling below the Primary Visual, not
   * overlaid — kept intentionally compact (spec §5's "smaller secondary
   * fragment") rather than matching the Primary Visual's width.
   */
  .hero-root__visual-secondary {
    margin-top: var(--space-8);
    width: min(70%, 320px);
    min-width: 0;
  }
  .hero-root__visual-secondary :global(.precision-visual) {
    max-width: 100%;
    min-width: 0;
  }

  .hero-root__ledger :global(.eval-ledger) {
    max-width: var(--measure-zh);
  }

  .hero-root__rail {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-steel-600);
  }

  /* ---- Desktop: 12-column editorial grid (ticket §8/spec §5) ---- */
  @media (min-width: 1024px) {
    .hero-root {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
      row-gap: 0;
      align-items: start;
    }

    .hero-root__origin {
      grid-column: 1 / 2;
      grid-row: 1;
      margin-bottom: var(--space-4);
    }
    .hero-root__eyebrow {
      grid-column: 1 / 6;
      grid-row: 2;
      margin-bottom: var(--space-3);
    }
    .hero-root__headline {
      grid-column: 1 / 10;
      grid-row: 3;
      font-size: var(--fs-h1);
      max-width: none;
      margin-bottom: var(--space-6);
    }
    :lang(en) .hero-root__headline {
      font-size: clamp(2.75rem, 3.6vw, 3.75rem);
    }
    .hero-root__body {
      grid-column: 1 / 6;
      grid-row: 4;
      font-size: var(--fs-body);
      margin-bottom: var(--space-6);
    }
    .hero-root__ctas {
      grid-column: 1 / 6;
      grid-row: 5;
      margin-bottom: 0;
    }
    .hero-root__visual {
      position: relative;
      grid-column: 5 / 12;
      grid-row: 1 / 6;
      margin-inline-end: -24px;
    }
    /*
     * HIGH-01 remediation: a real grid item (spec §5, "Secondary Visual
     * spans columns 10-13") on this Hero-owned wrapper, not a class handed
     * to PrecisionSystemVisual's own root — Astro scopes `<style>` per
     * component, so a selector written here can only ever match elements
     * that carry *this* file's scope attribute. The wrapper does; the
     * child component's internal <figure> does not.
     *
     * `grid-column: 10 / 13` stays within the Hero's 12 explicit tracks
     * (line 13 is the grid's own last explicit boundary) so this element
     * never forces an implicit 13th column into `grid-template-columns` —
     * verified by tests/e2e/cc02i-hero.spec.ts's existing "exactly 12
     * columns at desktop" assertion. The additional bleed spec §5/§3 allows
     * ("may exceed the 12-column grid by design, but never the viewport")
     * comes from `margin-inline-end`, the same bleed technique the Primary
     * Visual already uses two rules above, not from widening the grid
     * itself. Anchored to the bottom-right of the Primary Visual's row
     * span so the two read as one connected system, smaller fragment
     * layered forward.
     */
    .hero-root__visual-secondary {
      grid-column: 10 / 13;
      grid-row: 4 / 6;
      align-self: end;
      justify-self: end;
      width: 100%;
      max-width: 220px;
      margin-top: 0;
      margin-inline-end: -32px;
      position: relative;
      z-index: 1;
    }
    .hero-root__ledger {
      grid-column: 1 / 6;
      grid-row: 6;
      margin-top: var(--space-8);
    }
    .hero-root__rail {
      grid-column: 1 / 13;
      grid-row: 7;
      margin-top: var(--space-12);
    }
  }
  @media (min-width: 1280px) {
    .hero-root__visual {
      margin-inline-end: -48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-root * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

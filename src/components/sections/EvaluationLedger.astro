---
/**
 * EvaluationLedger — production Hero evaluation ledger (CC-02I-05),
 * rebuilt at its fixed path from the CC-02F prototype
 * (src/components/prototypes/cc02-final/EvaluationLedger.astro),
 * semantically identical `<dl>`/`<dt>`/`<dd>` structure. Three text
 * groups (heading + detail), no cards, no fake engineering numbers.
 *
 * Fixed prop contract: exactly three groups (not an unbounded array),
 * matching `Hero.astro`'s fixed assembly order
 * `[hero.ledger.input, hero.ledger.evaluation, hero.ledger.output]`.
 *
 * No client script, no animation, no data-motion-state hook — this
 * component has no motion of its own.
 */
export interface Props {
  groups: [
    { heading: string; detail: string },
    { heading: string; detail: string },
    { heading: string; detail: string },
  ];
  class?: string;
}

const { groups, class: className = '' } = Astro.props;
---

<dl class:list={['eval-ledger', className]}>
  {groups.map((group) => (
    <div class="eval-ledger__row">
      <dt class="eval-ledger__heading mono">{group.heading}</dt>
      <dd class="eval-ledger__detail">{group.detail}</dd>
    </div>
  ))}
</dl>

<style>
  .eval-ledger {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .eval-ledger__row {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-steel-600);
  }
  .eval-ledger__row:last-child {
    border-bottom: 1px solid var(--color-steel-600);
  }
  .eval-ledger__heading {
    display: block;
    margin: 0 0 var(--space-1);
    font-size: var(--fs-technical);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-copper-700);
  }
  .eval-ledger__detail {
    display: block;
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-steel-700);
  }
</style>

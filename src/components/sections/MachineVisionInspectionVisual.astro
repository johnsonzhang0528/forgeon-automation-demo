---
/**
 * YF-IMG-04 — representative machine-vision inspection imagery.
 *
 * The crop follows the optical axis from camera and lens through the ring
 * light to the fixtured workpieces. It must not imply a real product BOM,
 * optical specification, inspection result or customer installation.
 */
import { Picture } from 'astro:assets';
import machineVisionImage from '../../assets/images/solutions/machine-vision-inspection-final-master.png';
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';

export interface Props {
  locale: Locale;
  presentation?: 'master' | 'wide';
  priority?: boolean;
}

const { locale, presentation = 'master', priority = false } = Astro.props;
const imagery = getDictionary(locale).productionImagery.machineVisionInspection;
---

<figure
  class:list={['machine-vision-visual', `machine-vision-visual--${presentation}`]}
  data-production-image="YF-IMG-04"
  data-presentation={presentation}
>
  <div class="machine-vision-visual__media">
    <Picture
      src={machineVisionImage}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1280, 1447]}
      sizes="(min-width: 908px) 860px, (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
      alt={imagery.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      quality={82}
    />
  </div>
  <figcaption class="machine-vision-visual__caption">
    <span class="machine-vision-visual__marker" aria-hidden="true"></span>
    <span>{imagery.caption}</span>
  </figcaption>
</figure>

<style>
  .machine-vision-visual {
    margin: var(--space-xl) 0;
  }

  .machine-vision-visual__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-steel-900, #151a1e);
    aspect-ratio: 1 / 1;
  }

  .machine-vision-visual__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .machine-vision-visual__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 52%;
  }

  .machine-vision-visual__caption {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  .machine-vision-visual__marker {
    display: block;
    width: 100%;
    height: 2px;
    margin-top: 0.55em;
    background: var(--color-accent);
  }

  @media (min-width: 480px) {
    .machine-vision-visual__media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 768px) {
    .machine-vision-visual--wide .machine-vision-visual__media {
      aspect-ratio: 16 / 9;
    }

    .machine-vision-visual__caption {
      grid-template-columns: 3rem minmax(0, 44rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .machine-vision-visual__media,
    .machine-vision-visual__media :global(img) {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

---
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';
import Button from '../ui/Button.astro';

export interface Props {
  locale: Locale;
  title: string;
  description?: string;
}
const { locale, title, description } = Astro.props;
const dict = getDictionary(locale);
---

<section class="cta-banner">
  <div class="cta-banner__inner">
    <p class="cta-banner__datum mono">從這裡開始 · 提交需求</p>
    <div class="cta-banner__copy">
      <h2 class="cta-banner__title">{title}</h2>
      {description && <p class="cta-banner__desc">{description}</p>}
    </div>
    <div class="cta-banner__actions">
      <Button href={`/${locale}/contact/?intent=project`} variant="primary" size="lg" trackEvent="cta_click" data-intent="project" data-source="cta-banner">
        {dict.cta.primary}
      </Button>
      <Button href={`/${locale}/contact/?intent=technical-advice`} variant="secondary-invert" size="lg" trackEvent="cta_click" data-intent="technical-advice" data-source="cta-banner">
        {dict.cta.secondary}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    width: 100vw;
    margin-inline-start: 50%;
    transform: translateX(-50%);
    background: var(--color-ink);
    color: var(--color-invert-text);
    margin-top: var(--section-compact);
    border-top: var(--border-datum) solid var(--color-copper-500);
  }
  .cta-banner__inner {
    max-width: var(--container-content);
    margin-inline: auto;
    padding: clamp(var(--space-2xl), 6vw, var(--space-16)) var(--page-gutter-desktop);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }
  .cta-banner__datum {
    margin: 0;
    color: var(--color-copper-500);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cta-banner__copy {
    min-width: 0;
  }
  .cta-banner__title {
    color: var(--color-invert-text);
    margin: 0 0 var(--space-sm);
    max-width: 22ch;
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }
  .cta-banner__desc {
    color: var(--color-invert-muted);
    margin: 0;
    max-width: 52ch;
  }
  .cta-banner__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }
  .cta-banner__actions :global(.btn--secondary-invert) {
    background: transparent;
    border-color: transparent;
    color: var(--color-invert-muted);
    padding-inline: 0;
  }
  .cta-banner__actions :global(.btn--secondary-invert:hover) {
    background: transparent;
    color: var(--color-invert-text);
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  @media (min-width: 560px) {
    .cta-banner__actions {
      flex-direction: row;
      align-items: center;
    }
  }
</style>

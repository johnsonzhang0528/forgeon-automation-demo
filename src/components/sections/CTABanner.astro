---
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';
import Button from '../ui/Button.astro';

export interface Props {
  locale: Locale;
  title: string;
  description?: string;
}
const { locale, title, description } = Astro.props;
const dict = getDictionary(locale);
---

<section class="cta-banner">
  <div class="container cta-banner__inner">
    <div class="cta-banner__copy">
      <h2 class="cta-banner__title">{title}</h2>
      {description && <p class="cta-banner__desc">{description}</p>}
    </div>
    <div class="cta-banner__actions">
      <Button href={`/${locale}/contact/`} variant="primary" size="lg" trackEvent="cta_click">
        {dict.cta.primary}
      </Button>
      <Button href={`/${locale}/contact/`} variant="secondary" size="lg" trackEvent="cta_click">
        {dict.cta.secondary}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-ink);
    color: var(--color-invert-text);
    border-radius: var(--radius-lg);
    margin-inline: var(--container-padding);
  }
  .cta-banner__inner {
    max-width: var(--container-max);
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .cta-banner__title {
    color: var(--color-invert-text);
    margin: 0 0 var(--space-2xs);
    font-size: var(--fs-2xl);
  }
  .cta-banner__desc {
    color: var(--color-invert-muted);
    margin: 0;
    max-width: 56ch;
  }
  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (min-width: 860px) {
    .cta-banner__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

---
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';
import Button from '../ui/Button.astro';

export interface Props {
  locale: Locale;
  title: string;
  description?: string;
}
const { locale, title, description } = Astro.props;
const dict = getDictionary(locale);
---

<section class="cta-banner">
  <div class="cta-banner__inner">
    <div class="cta-banner__copy">
      <h2 class="cta-banner__title">{title}</h2>
      {description && <p class="cta-banner__desc">{description}</p>}
    </div>
    <div class="cta-banner__actions">
      <Button href={`/${locale}/contact/?intent=project`} variant="primary" size="lg" trackEvent="cta_click" data-intent="project" data-source="cta-banner">
        {dict.cta.primary}
      </Button>
      <Button href={`/${locale}/contact/?intent=technical-advice`} variant="secondary-invert" size="lg" trackEvent="cta_click" data-intent="technical-advice" data-source="cta-banner">
        {dict.cta.secondary}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-invert-text);
    border-radius: var(--radius-md);
    margin-block: var(--section-compact);
    border: var(--border-hairline) solid var(--color-ink-800);
  }
  .cta-banner::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--border-datum);
    width: clamp(4rem, 10vw, 8rem);
    background: var(--color-copper-500);
  }
  .cta-banner__inner {
    padding: clamp(var(--space-lg), 5vw, var(--space-16));
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .cta-banner__copy {
    min-width: 0;
  }
  .cta-banner__title {
    color: var(--color-invert-text);
    margin: 0 0 var(--space-xs);
    max-width: 19ch;
    font-size: var(--fs-2xl);
    text-wrap: balance;
  }
  .cta-banner__desc {
    color: var(--color-invert-muted);
    margin: 0;
    max-width: 52ch;
  }
  .cta-banner__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }
  .cta-banner__actions :global(.btn) {
    width: 100%;
    max-width: 100%;
    white-space: normal;
    text-align: center;
    justify-content: center;
  }

  @media (min-width: 560px) {
    .cta-banner__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    .cta-banner__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 960px) {
    .cta-banner__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .cta-banner__actions {
      flex-shrink: 0;
      justify-content: flex-end;
    }
  }
</style>

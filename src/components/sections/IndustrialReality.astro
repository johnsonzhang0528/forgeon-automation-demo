---
/**
 * Industrial Reality Check — Homepage Third Signature Moment (Phase 5E).
 *
 * No dedicated "Industrial Reality" master image was produced in the
 * earlier imaging phase (only Hero, VISION-X2 Macro, VISION-X2 Whole
 * Product exist) — per this ticket's own rule 1, this section instead
 * uses existing production-approved imagery: automation-integration-
 * final-master.png (already used on the Solutions page via
 * AutomationIntegrationVisual.astro, with existing approved alt/caption
 * copy in productionImagery.automationIntegration). That component's own
 * bordered-card, small-caption treatment is NOT reused here — this
 * section needs a full-bleed authored composition, not the generic
 * factory-photo-block treatment the ticket explicitly warns against.
 *
 * Scale escalation from the prior two Signature Moments (Human/ChatGPT
 * Phase 5D-R1 Gate direction): Hero establishes brand + a single
 * precision motion moment; VISION-X2 Signature is one precision
 * instrument in isolation; this section escalates to a complete
 * integrated automation CELL (robot + conveyor + fixtures + control
 * cabinet) inside a real production environment — proving FORGEON scales
 * from component to deployable system. This is deliberately NOT another
 * product showcase.
 *
 * Photographic treatment is deliberately different from both prior
 * moments: this is a real, naturally-lit factory photograph (fluorescent
 * overhead lighting, daylight-balanced), not a studio/controlled-
 * darkness product shot — so unlike Hero's environmental scrim or
 * VISION-X2's near-black studio background, this section does NOT wash
 * the whole frame in a dark gradient (that would misrepresent real
 * photography as a lit product shot and risk reading as "stock photo
 * with text placed underneath," which this ticket explicitly forbids).
 * Scrims here are small and localized, only where text sits on the
 * image, not sitewide.
 *
 * Annotation rule (ticket rules 3-5): the four location labels below
 * name real, visible physical equipment (robotic arm / locating fixture
 * / conveyor / control cabinet) at their actual position in the frame —
 * they are identification labels, not measurements. No numeric values,
 * no PASS/FAIL state, no fabricated telemetry are attached to them.
 */
import { Picture } from 'astro:assets';
import industrialImage from '../../assets/images/solutions/automation-integration-final-master.png';
import { getDictionary } from '../../utils/i18n';
import type { Locale } from '../../config/site';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const copy = dictionary.industrialReality;
const productionImage = dictionary.productionImagery.automationIntegration;

/*
 * Marker positions are authored against the actual pixel geometry of
 * automation-integration-final-master.png (1535×1024) — each one sits on
 * a real, visibly-identifiable piece of equipment in the frame, not an
 * arbitrary grid. Percentages are of the full image, independent of
 * object-position/crop so they can be reused at other breakpoints if the
 * crop ever changes (though it does not in this pass).
 */
const equipment = [
  { key: 'arm', code: 'A', anchorX: 33, anchorY: 40, labelX: 5, labelY: 40, leader: 'M 20 42 H 28 V 40 H 33' },
  { key: 'fixture', code: 'B', anchorX: 55, anchorY: 52, labelX: 65, labelY: 56, leader: 'M 65 58 H 60 V 52 H 55' },
  { key: 'conveyor', code: 'C', anchorX: 18, anchorY: 54, labelX: 4, labelY: 68, leader: 'M 19 70 H 15 V 54 H 18' },
  { key: 'control', code: 'D', anchorX: 84, anchorY: 29, labelX: 76, labelY: 25, leader: 'M 76 29 H 84' },
] as const;
---

<section class="ir" aria-labelledby="ir-heading">
  <div class="ir-frame">
    <div class="ir-frame__top">
      <p class="ir-frame__eyebrow mono">{copy.eyebrow}</p>
      <h2 id="ir-heading" class="ir-frame__statement">{copy.statement}</h2>
    </div>

    <figure
      class="ir-frame__media"
      data-production-image="YF-IMG-02"
      data-presentation="wide"
    >
      <Picture
        src={industrialImage}
        formats={['avif', 'webp']}
        widths={[480, 768, 1024, 1440, 1920]}
        sizes="100vw"
        alt={copy.imageAlt}
        loading="lazy"
        fetchpriority="auto"
        decoding="async"
        quality={82}
      />
      <figcaption class="visually-hidden">{productionImage.caption}</figcaption>
    </figure>

    <div class="ir-identifications">
      <svg class="ir-identifications__leaders" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {equipment.map((item) => <path d={item.leader} vector-effect="non-scaling-stroke" />)}
      </svg>
      {equipment.map((item) => (
        <div
          class="ir-identification"
          data-equipment={item.key}
          data-anchor-x={item.anchorX}
          data-anchor-y={item.anchorY}
          style={`--anchor-x:${item.anchorX}%; --anchor-y:${item.anchorY}%; --label-x:${item.labelX}%; --label-y:${item.labelY}%;`}
        >
          <span class="ir-identification__anchor mono" aria-hidden="true">{item.code}</span>
          <span class="ir-identification__label">
            <span class="ir-identification__code mono" aria-hidden="true">{item.code}</span>
            <span>{copy.labels[item.key]}</span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <dl class="ir-equipment-key">
    {equipment.map((item) => (
      <div class="ir-equipment-key__item" data-equipment-key={item.key}>
        <dt class="mono">{item.code}</dt>
        <dd>{copy.labels[item.key]}</dd>
      </div>
    ))}
  </dl>

  <p class="ir-closing">{copy.closing}</p>
</section>

<style>
  .ir {
    background: var(--color-ink-950);
    color: var(--color-invert-text, #fff);
  }

  .ir-frame {
    position: relative;
    width: 100%;
    max-width: 1535px;
    margin-inline: auto;
    overflow: hidden;
  }
  .ir-frame__media {
    margin: 0;
    aspect-ratio: 1535 / 1024;
  }
  .ir-frame__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ir-frame__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ir-frame__top {
    padding: var(--space-6) var(--page-gutter-mobile) var(--space-5);
    background: var(--color-ink-950);
  }
  .ir-frame__eyebrow {
    margin: 0 0 var(--space-2);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ir-frame__statement {
    margin: 0;
    max-width: 22ch;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4vw, 1.625rem);
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }
  :lang(zh-Hant-TW) .ir-frame__statement {
    font-family: 'Noto Sans TC', var(--font-display);
  }

  .ir-identifications {
    position: absolute;
    inset: auto 0 0;
    aspect-ratio: 1535 / 1024;
    pointer-events: none;
  }
  .ir-identifications__leaders,
  .ir-identification__label {
    display: none;
  }
  .ir-identification__anchor {
    position: absolute;
    left: var(--anchor-x);
    top: var(--anchor-y);
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(11, 31, 58, 0.82);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 600;
  }

  .ir-equipment-key {
    display: grid;
    margin: 0;
    padding: 0 var(--page-gutter-mobile);
    background: var(--color-ink-950);
  }
  .ir-equipment-key__item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .ir-equipment-key__item dt {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.6875rem;
  }
  .ir-equipment-key__item dd {
    margin: 0;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .ir-closing {
    margin: 0;
    padding: var(--space-7) var(--page-gutter-mobile) var(--space-8);
    max-width: 42em;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .ir-frame__top {
      padding-inline: var(--page-gutter-tablet);
    }
    .ir-closing {
      padding-inline: var(--page-gutter-tablet);
    }
    .ir-equipment-key {
      padding-inline: var(--page-gutter-tablet);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 900px) {
    .ir-identifications {
      inset: 0;
      aspect-ratio: auto;
    }
    .ir-frame__top {
      position: absolute;
      z-index: 2;
      top: 0;
      left: 0;
      width: min(43rem, 50%);
      padding: var(--space-8) var(--page-gutter-desktop) var(--space-12);
      background: linear-gradient(180deg, rgba(5, 14, 27, 0.9), rgba(5, 14, 27, 0.58) 68%, transparent);
    }
    .ir-frame__statement {
      max-width: 26ch;
      font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    }
    .ir-identifications__leaders {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    .ir-identifications__leaders path {
      fill: none;
      stroke: rgba(255, 255, 255, 0.72);
      stroke-width: 1px;
    }
    .ir-identification__anchor {
      width: 0.55rem;
      height: 0.55rem;
      border: 2px solid #fff;
      background: var(--color-ink-950);
      color: transparent;
    }
    .ir-identification__label {
      position: absolute;
      left: var(--label-x);
      top: var(--label-y);
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-2);
      min-width: 10rem;
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid rgba(255, 255, 255, 0.82);
      background: rgba(5, 14, 27, 0.76);
      color: #fff;
      font-size: clamp(0.75rem, 1vw, 0.875rem);
      font-weight: 500;
      white-space: nowrap;
    }
    .ir-identification__code {
      color: rgba(255, 255, 255, 0.58);
      font-size: 0.625rem;
    }
    .ir-equipment-key {
      display: none;
    }
    .ir-closing {
      max-width: 100%;
      padding: var(--space-8) var(--page-gutter-desktop) var(--space-9);
      font-size: 1rem;
    }
  }
</style>

---
/**
 * YF-IMG-05 — representative precision-motion and handling imagery.
 *
 * The focal crop preserves the linear-axis, Z-axis, parallel-gripper,
 * workpiece and fixture relationship. It must not imply a real product,
 * customer installation or measured motion/handling performance.
 */
import { Picture } from 'astro:assets';
import precisionHandlingImage from '../../assets/images/solutions/precision-motion-handling-final-master.png';
import type { Locale } from '../../config/site';
import { getDictionary } from '../../utils/i18n';

export interface Props {
  locale: Locale;
  presentation?: 'master' | 'wide';
  priority?: boolean;
}

const { locale, presentation = 'master', priority = false } = Astro.props;
const imagery = getDictionary(locale).productionImagery.precisionHandling;
---

<figure
  class:list={['precision-handling-visual', `precision-handling-visual--${presentation}`]}
  data-production-image="YF-IMG-05"
  data-presentation={presentation}
>
  <div class="precision-handling-visual__media">
    <Picture
      src={precisionHandlingImage}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1280, 1536]}
      sizes="(min-width: 908px) 860px, (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
      alt={imagery.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      quality={82}
    />
  </div>
  <figcaption class="precision-handling-visual__caption">
    <span class="precision-handling-visual__marker" aria-hidden="true"></span>
    <span>{imagery.caption}</span>
  </figcaption>
</figure>

<style>
  .precision-handling-visual {
    margin: var(--space-xl) 0;
  }

  .precision-handling-visual__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-steel-900, #151a1e);
    aspect-ratio: 1 / 1;
  }

  .precision-handling-visual__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .precision-handling-visual__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }

  .precision-handling-visual__caption {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  .precision-handling-visual__marker {
    display: block;
    width: 100%;
    height: 2px;
    margin-top: 0.55em;
    background: var(--color-accent);
  }

  @media (min-width: 480px) {
    .precision-handling-visual__media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 768px) {
    .precision-handling-visual--master .precision-handling-visual__media {
      aspect-ratio: 3 / 2;
    }

    .precision-handling-visual--wide .precision-handling-visual__media {
      aspect-ratio: 16 / 9;
    }

    .precision-handling-visual__caption {
      grid-template-columns: 3rem minmax(0, 44rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .precision-handling-visual__media,
    .precision-handling-visual__media :global(img) {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

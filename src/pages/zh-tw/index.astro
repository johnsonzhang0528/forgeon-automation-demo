---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Hero from '../../components/sections/Hero.astro';
import AutomationIntegrationVisual from '../../components/sections/AutomationIntegrationVisual.astro';
import FieldCommissioningVisual from '../../components/sections/FieldCommissioningVisual.astro';
import SolutionCard from '../../components/ui/SolutionCard.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import IndustryCard from '../../components/ui/IndustryCard.astro';
import ProcessTimeline from '../../components/ui/ProcessTimeline.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import { getSortedSolutions, getSortedProducts, getSortedIndustries } from '../../utils/content';

const locale = 'zh-tw' as const;

const solutions = (await getSortedSolutions()).slice(0, 3);
const products = await getSortedProducts();
const industries = await getSortedIndustries();

const processSteps = [
  { title: '需求釐清', description: '了解製程背景、現有設備介面與導入目標，確認初步可行性。' },
  { title: '方案評估', description: '依工件、節拍與空間條件，提出運動、視覺或整合方案的技術評估。' },
  { title: '設計與報價', description: '完成機構與系統設計，提供正式技術方案與報價。' },
  { title: '製作與測試', description: '模組製作、系統整合與內部功能測試，確認符合設計條件。' },
  { title: '導入與驗收', description: '現場安裝、調整與驗收，並提供操作與維護說明。' },
];

const whyReasons = [
  { title: '工程導向流程', desc: '每個方案都從實際製程問題出發，先確認可行性再進入設計，不做無根據的承諾。' },
  { title: '模組化產品線', desc: '運動、視覺與組裝模組可單獨導入或組合使用，依專案規模彈性配置。' },
  { title: '結構化技術文件', desc: '規格、選配與導入條件均以文件化方式呈現，方便工程團隊內部評估與比較。' },
  { title: '中英文技術溝通', desc: '以中英文整理規格、介面與導入條件，方便跨地區團隊確認需求與責任邊界。' },
];
---

<BaseLayout
  locale={locale}
  path="/zh-tw/"
  otherLocalePath="/en/"
  title="鋒岳自動化｜精密運動與視覺整合的工業自動化方案"
  description="鋒岳自動化是虛構的工業自動化品牌概念案例，展示精密運動、視覺定位與自動化組裝整合的網站策略與工程資訊架構。"
>
  <!-- Hero -->
  <Hero locale={locale} />

  <!-- Capability overview -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="核心能力"
        title="從精密運動到系統整合"
        description="鋒岳自動化的能力涵蓋運動模組設計、視覺定位檢測與整廠整合工程，讓客戶可以依專案規模選擇單一模組或完整方案。"
      />
      <AutomationIntegrationVisual locale={locale} presentation="wide" />
      <div class="capability-grid">
        <div class="capability-item">
          <span class="capability-item__index mono">01</span>
          <h3>精密線性運動模組</h3>
          <p>高剛性結構搭配伺服傳動，提供加工、檢測與組裝站點所需的重複定位精度。</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">02</span>
          <h3>視覺定位與檢測</h3>
          <p>工業相機與影像演算法處理工件定位、瑕疵檢測與條碼特徵辨識。</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">03</span>
          <h3>自動化組裝整合</h3>
          <p>模組化組裝工作站搭配機械手臂與客製治具，適合中小批量多款式生產。</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">04</span>
          <h3>既有產線升級</h3>
          <p>針對瓶頸站點導入局部自動化，不需整線重建即可改善產能限制。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="解決方案"
        title="依製程挑戰配置的自動化方案"
        description="從精密定位到視覺檢測，每項方案都從實際製程問題出發。"
      />
      <div class="grid-auto">
        {solutions.map((s) => (
          <SolutionCard
            locale={locale}
            slug={s.data.entrySlug}
            name={s.data.name['zh-tw']}
            description={s.data.shortDescription['zh-tw']}
            hasDetailPage={s.data.hasDetailPage}
          />
        ))}
      </div>
      <div class="section-cta">
        <Button href="/zh-tw/solutions/" variant="secondary">查看解決方案</Button>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section section--tight section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="代表產品"
        title="模組化產品線"
        description="三款核心產品可獨立導入，也可組合為完整自動化站點。"
      />
      <div class="grid-auto">
        {products.map((p) => (
          <ProductCard
            locale={locale}
            slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
            name={p.data.name}
            positioning={p.data.positioning['zh-tw']}
            description={p.data.shortDescription['zh-tw']}
          />
        ))}
      </div>
      <div class="section-cta">
        <Button href="/zh-tw/products/" variant="secondary">查看產品規格</Button>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="應用產業"
        title="服務的產業範圍"
        description="從半導體到包裝物流，依產業特性配置適合的自動化方案。"
      />
      <div class="grid-auto">
        {industries.map((ind) => (
          <IndustryCard
            locale={locale}
            slug={ind.data.entrySlug as any}
            name={ind.data.name['zh-tw']}
            description={ind.data.shortDescription['zh-tw']}
            hasDetailPage={ind.data.hasDetailPage}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Fit / not-fit -->
  <section class="section section--tight section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="適合評估"
        title="鋒岳自動化適合什麼情況，不適合什麼情況"
        description="在提交詢價前，先確認您的專案背景是否落在我們實際能提供價值的範圍內。"
      />
      <div class="fit-grid">
        <div class="fit-card fit-card--yes">
          <h3>適合的情況</h3>
          <ul>
            <li>加工、檢測或組裝站點需要穩定的重複定位精度，且已能描述工件尺寸與節拍需求</li>
            <li>既有產線有明確瓶頸站點，希望局部自動化升級而非整線重建</li>
            <li>需要視覺定位或瑕疵檢測，且製程條件（光源、工件表面特性）大致明確</li>
            <li>專案規模足以支撐工程評估與客製設計（非單一標準品採購）</li>
          </ul>
        </div>
        <div class="fit-card fit-card--no">
          <h3>暫時不適合的情況</h3>
          <ul>
            <li>僅需採購單一標準零組件，不需要整合工程或客製設計</li>
            <li>製程條件尚未確認（例如工件規格、節拍、現場空間都還在變動），建議先完成內部評估</li>
            <li>時程要求在標準工程評估週期內無法完成（例如兩週內需要完整方案定案）</li>
            <li>需要防爆、無塵室特殊等級或其他尚未經過工程確認的特殊環境認證</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Two browsing paths -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="從這裡開始"
        title="依您的角色選擇瀏覽路徑"
        description="兩種最常見的進站情境，各自對應不同的下一步。"
        align="center"
      />
      <div class="path-grid">
        <a href="/zh-tw/industries/" class="path-card">
          <span class="path-card__label">海外採購／工廠管理者</span>
          <h3>先確認產業與能力是否對應</h3>
          <p>依產業別瀏覽常見製程問題與適合的解決方案，快速判斷是否值得深入了解。</p>
          <span class="path-card__cta">瀏覽產業應用 →</span>
        </a>
        <a href="/zh-tw/products/" class="path-card">
          <span class="path-card__label">自動化／製程工程師</span>
          <h3>先確認產品規格與系統相容性</h3>
          <p>直接查看三款核心產品的完整規格表、選配項目與相容方案，評估技術可行性。</p>
          <span class="path-card__cta">瀏覽產品規格 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--tight section--alt">
    <div class="container container--narrow">
      <SectionHeading
        eyebrow="專案導入流程"
        title="從需求釐清到現場驗收"
        description="以五個階段呈現評估與交付框架，逐步確認需求、設計、測試與驗收條件。"
      />
      <FieldCommissioningVisual locale={locale} presentation="wide" />
      <ProcessTimeline steps={processSteps} />
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="合作理由" title="為什麼與鋒岳自動化合作" align="center" />
      <div class="grid-auto">
        {whyReasons.map((r) => (
          <div class="why-item">
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <div class="container">
    <CTABanner
      locale={locale}
      title="準備好討論您的自動化需求了嗎？"
      description="提交專案背景與需求，我們的技術團隊將協助評估可行的解決方案。"
    />
  </div>
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-surface-alt);
  }

  .container--narrow {
    max-width: 860px;
  }

  .capability-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .capability-item {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .capability-item__index {
    color: var(--color-accent);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .capability-item h3 {
    margin: var(--space-2xs) 0;
    font-size: var(--fs-md);
  }
  .capability-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .section-cta {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
  }

  .why-item {
    text-align: center;
    padding: var(--space-lg);
  }
  .why-item h3 {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-2xs);
  }
  .why-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .fit-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .fit-card {
    background: var(--color-card);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    border-top: 3px solid var(--color-border-strong);
  }
  .fit-card--yes {
    border-top-color: var(--color-success);
  }
  .fit-card--no {
    border-top-color: var(--color-muted);
  }
  .fit-card h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-md);
  }
  .fit-card ul {
    margin: 0;
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .fit-card li {
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .path-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .path-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }
  .path-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .path-card__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }
  .path-card h3 {
    margin: var(--space-2xs) 0;
    font-size: var(--fs-lg);
  }
  .path-card p {
    margin: 0 0 var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }
  .path-card__cta {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-top: auto;
  }

  @media (min-width: 720px) {
    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .fit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .path-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .capability-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

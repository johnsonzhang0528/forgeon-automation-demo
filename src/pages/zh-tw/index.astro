---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Hero from '../../components/sections/Hero.astro';
import AutomationIntegrationVisual from '../../components/sections/AutomationIntegrationVisual.astro';
import FieldCommissioningVisual from '../../components/sections/FieldCommissioningVisual.astro';
import SolutionCard from '../../components/ui/SolutionCard.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import IndustryCard from '../../components/ui/IndustryCard.astro';
import ProcessTimeline from '../../components/ui/ProcessTimeline.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import { getSortedSolutions, getSortedProducts, getSortedIndustries } from '../../utils/content';
import '../../styles/home-refinement.css';

const locale = 'zh-tw' as const;

const solutions = (await getSortedSolutions()).slice(0, 3);
const products = await getSortedProducts();
const industries = await getSortedIndustries();
const [productAnchor, ...productPair] = products;
if (!productAnchor) {
  throw new Error('Products collection is empty — the Product Editorial Plate requires at least one product.');
}

const processSteps = [
  { title: '需求釐清', description: '了解製程背景、現有設備介面與導入目標，確認初步可行性。' },
  { title: '方案評估', description: '依工件、節拍與空間條件，提出運動、視覺或整合方案的技術評估。' },
  { title: '設計與報價', description: '完成機構與系統設計，提供正式技術方案與報價。' },
  { title: '製作與測試', description: '模組製作、系統整合與內部功能測試，確認符合設計條件。' },
  { title: '導入與驗收', description: '現場安裝、調整與驗收，並提供操作與維護說明。' },
];

const whyReasons = [
  { title: '工程導向流程', desc: '每個方案都從實際製程問題出發，先確認可行性再進入設計，不做無根據的承諾。' },
  { title: '模組化產品線', desc: '運動、視覺與組裝模組可單獨導入或組合使用，依專案規模彈性配置。' },
  { title: '結構化技術文件', desc: '規格、選配與導入條件均以文件化方式呈現，方便工程團隊內部評估與比較。' },
  { title: '中英文技術溝通', desc: '以中英文整理規格、介面與導入條件，方便跨地區團隊確認需求與責任邊界。' },
];
---

<BaseLayout
  locale={locale}
  path="/zh-tw/"
  otherLocalePath="/en/"
  title="鋒岳自動化｜精密運動與視覺整合的工業自動化方案"
  description="鋒岳自動化是虛構的工業自動化品牌概念案例，展示精密運動、視覺定位與自動化組裝整合的網站策略與工程資訊架構。"
  bodyClass="home-dark-ending"
>
  <!-- Hero -->
  <Hero locale={locale} />

  <!-- Capability overview: quiet supporting section, not a second Hero. -->
  <section class="section section-compact">
    <div class="container">
      <SectionHeading
        compact
        eyebrow="核心能力"
        title="從精密運動到系統整合"
        description="鋒岳自動化的能力涵蓋運動模組設計、視覺定位檢測與整廠整合工程，讓客戶可以依專案規模選擇單一模組或完整方案。"
      />
      <AutomationIntegrationVisual locale={locale} presentation="wide" />
      <div class="capability-grid">
        <div class="capability-item">
          <span class="capability-item__index mono">01</span>
          <h3>精密線性運動模組</h3>
          <p>高剛性結構搭配伺服傳動，提供加工、檢測與組裝站點所需的重複定位精度。</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">02</span>
          <h3>視覺定位與檢測</h3>
          <p>工業相機與影像演算法處理工件定位、瑕疵檢測與條碼特徵辨識。</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">03</span>
          <h3>自動化組裝整合</h3>
          <p>模組化組裝工作站搭配機械手臂與客製治具，適合中小批量多款式生產。</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">04</span>
          <h3>既有產線升級</h3>
          <p>針對瓶頸站點導入局部自動化，不需整線重建即可改善產能限制。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions: quiet supporting section. -->
  <section class="section section-compact">
    <div class="container">
      <SectionHeading
        compact
        eyebrow="解決方案"
        title="依製程挑戰配置的自動化方案"
        description="從精密定位到視覺檢測，每項方案都從實際製程問題出發。"
      />
      <div class="solution-index">
        {solutions.map((s) => (
          <SolutionCard
            locale={locale}
            slug={s.data.entrySlug}
            name={s.data.name['zh-tw']}
            description={s.data.shortDescription['zh-tw']}
            hasDetailPage={s.data.hasDetailPage}
          />
        ))}
      </div>
      <div class="section-cta">
        <Button href="/zh-tw/solutions/" variant="ghost">查看全部解決方案 →</Button>
      </div>
    </div>
  </section>

  <!-- Products: Mid-page Signature Composition (page moment B). Full
       section-major rhythm and the page's second full-weight heading —
       everything before it exists to arrive here. -->
  <section class="section section-major section--alt product-signature">
    <div class="container">
      <SectionHeading
        eyebrow="代表產品"
        title="模組化產品線"
        description="三款核心產品可獨立導入，也可組合為完整自動化站點。"
      />
      <div class="product-plate">
        <div class="product-plate__anchor">
          <ProductCard
            locale={locale}
            slug={productAnchor.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
            name={productAnchor.data.name}
            positioning={productAnchor.data.positioning['zh-tw']}
            description={productAnchor.data.shortDescription['zh-tw']}
            dominant
          />
        </div>
        <div class="product-plate__pair">
          {productPair.map((p) => (
            <ProductCard
              locale={locale}
              slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
              name={p.data.name}
              positioning={p.data.positioning['zh-tw']}
              description={p.data.shortDescription['zh-tw']}
            />
          ))}
        </div>
      </div>
      <div class="section-cta">
        <Button href="/zh-tw/products/" variant="ghost">比較完整產品規格 →</Button>
      </div>
    </div>
  </section>

  <!-- Industries: quiet supporting section. -->
  <section class="section section-compact">
    <div class="container">
      <SectionHeading
        compact
        eyebrow="應用產業"
        title="服務的產業範圍"
        description="從半導體到包裝物流，依產業特性配置適合的自動化方案。"
      />
      <div class="industry-index">
        {industries.map((ind) => (
          <IndustryCard
            locale={locale}
            slug={ind.data.entrySlug as any}
            name={ind.data.name['zh-tw']}
            description={ind.data.shortDescription['zh-tw']}
            hasDetailPage={ind.data.hasDetailPage}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Fit assessment + browsing paths: one compact decision-support block,
       not two separate generic two/four-item patterns. -->
  <section class="section section-compact section--alt">
    <div class="container">
      <div class="assess-block">
        <div class="assess-block__fit">
          <p class="assess-block__eyebrow mono">適合評估</p>
          <h2 class="assess-block__title">鋒岳自動化適合什麼情況，不適合什麼情況</h2>
          <div class="fit-columns">
            <div class="fit-col fit-col--yes">
              <h3>適合的情況</h3>
              <ul>
                <li>加工、檢測或組裝站點需要穩定的重複定位精度，且已能描述工件尺寸與節拍需求</li>
                <li>既有產線有明確瓶頸站點，希望局部自動化升級而非整線重建</li>
                <li>需要視覺定位或瑕疵檢測，且製程條件（光源、工件表面特性）大致明確</li>
                <li>專案規模足以支撐工程評估與客製設計（非單一標準品採購）</li>
              </ul>
            </div>
            <div class="fit-col fit-col--no">
              <h3>暫時不適合的情況</h3>
              <ul>
                <li>僅需採購單一標準零組件，不需要整合工程或客製設計</li>
                <li>製程條件尚未確認（例如工件規格、節拍、現場空間都還在變動），建議先完成內部評估</li>
                <li>時程要求在標準工程評估週期內無法完成（例如兩週內需要完整方案定案）</li>
                <li>需要防爆、無塵室特殊等級或其他尚未經過工程確認的特殊環境認證</li>
              </ul>
            </div>
          </div>
        </div>
        <aside class="assess-block__paths">
          <p class="assess-block__eyebrow mono">從這裡開始</p>
          <a href="/zh-tw/industries/" class="path-link">
            <span class="path-link__label">海外採購／工廠管理者</span>
            <span class="path-link__desc">依產業別瀏覽常見製程問題與適合的解決方案 →</span>
          </a>
          <a href="/zh-tw/products/" class="path-link">
            <span class="path-link__label">自動化／製程工程師</span>
            <span class="path-link__desc">直接查看三款核心產品的完整規格表 →</span>
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Process: narrative pairing of the on-site photograph with the
       delivery stages, not "image then a documentation list" — the
       photograph stays visible beside every stage as the throughline. -->
  <section class="section section-compact section--alt">
    <div class="container">
      <SectionHeading
        compact
        eyebrow="專案導入流程"
        title="從需求釐清到現場驗收"
        description="以五個階段呈現評估與交付框架，逐步確認需求、設計、測試與驗收條件。"
      />
      <div class="process-narrative">
        <div class="process-narrative__media">
          <FieldCommissioningVisual locale={locale} presentation="wide" />
        </div>
        <div class="process-narrative__steps">
          <ProcessTimeline steps={processSteps} />
        </div>
      </div>
    </div>
  </section>

  <!-- Why us: quiet closing transition, not a third full-weight
       declaration competing with Final CTA. -->
  <section class="section why-strip">
    <div class="container">
      <p class="why-strip__label mono">合作理由</p>
      <ul class="why-strip__list">
        {whyReasons.map((r) => (
          <li class="why-strip__item">
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    locale={locale}
    title="準備好討論您的自動化需求了嗎？"
    description="提交專案背景與需求，我們的技術團隊將協助評估可行的解決方案。"
  />
</BaseLayout>

<style>
  /* CTA banner and Footer share the same dark ink background — remove the
     Footer's default top margin only on this page so the two read as one
     continuous dark ending rather than a dark card floating in white space
     before another dark block (P1-4, docs/uiux-upgrade/09-product-plate-
     and-ending.md). Footer.astro is a child component with its own Astro
     scope hash, so this must be :global() to reach the rendered <footer>
     node (same reason Header.astro's own CSS documents for
     .site-header__cta). Scoped via the page's own bodyClass rather than a
     :has() selector, and rather than editing Footer.astro's default
     margin, which is shared by every other page. */
  :global(body.home-dark-ending .site-footer) {
    margin-top: 0;
  }

  /* LC-02: --section-major's padding-bottom (clamp(120px, 12vw, 176px),
     ~173px at 1440px) read as an accidental oversized gap after the "比較
     完整產品規格" link — the top half (heading -> visual) is a normal
     48px, so the section was front-light/bottom-heavy. Trimmed ~18% at
     every width via the same clamp shape, scoped to this page's own
     Products section only; utilities.css's shared .section-major class
     and its consumers elsewhere are untouched. */
  .product-signature {
    padding-bottom: clamp(98px, 9.8vw, 145px);
  }

  .section--alt {
    background: var(--color-surface-alt);
  }

  .container--narrow {
    max-width: 860px;
  }

  .process-narrative {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .process-narrative {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
      gap: var(--space-2xl);
    }
    .process-narrative__media {
      position: sticky;
      top: calc(80px + var(--space-lg));
    }
  }

  .capability-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .capability-item {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .capability-item__index {
    color: var(--color-accent);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .capability-item h3 {
    margin: var(--space-2xs) 0;
    font-size: var(--fs-md);
  }
  .capability-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .section-cta {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
  }

  /* Quiet closing transition — deliberately not another Section­Heading +
     grid declaration; see docs/uiux-upgrade/08-fullpage-composition.md. */
  .why-strip {
    padding-block: var(--space-2xl);
  }
  .why-strip__label {
    margin: 0 0 var(--space-md);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .why-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md) var(--space-xl);
    grid-template-columns: 1fr;
  }
  .why-strip__item h3 {
    margin: 0 0 0.2em;
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .why-strip__item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  /* Fit assessment + browsing paths, merged into one compact
     decision-support block rather than two symmetric two/four-item
     sections (see docs/uiux-upgrade/08-fullpage-composition.md). */
  .assess-block {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
  }
  .assess-block__eyebrow {
    margin: 0 0 var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .assess-block__title {
    margin: 0 0 var(--space-lg);
    max-width: 34ch;
    font-size: var(--fs-md);
    font-weight: 600;
    text-wrap: balance;
  }
  .fit-columns {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .fit-col {
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-border-strong);
  }
  .fit-col--yes {
    border-top-color: var(--color-success);
  }
  .fit-col--no {
    border-top-color: var(--color-muted);
  }
  .fit-col h3 {
    margin: 0 0 var(--space-xs);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .fit-col ul {
    margin: 0;
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .fit-col li {
    color: var(--color-ink-soft);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  .assess-block__paths {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }
  .path-link {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    padding-block: var(--space-xs);
    text-decoration: none;
    color: inherit;
  }
  .path-link + .path-link {
    border-top: 1px solid var(--color-border);
  }
  .path-link__label {
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .path-link__desc {
    color: var(--color-muted);
    font-size: var(--fs-xs);
  }
  .path-link:hover .path-link__label {
    color: var(--color-accent-dark);
  }

  @media (min-width: 720px) {
    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .fit-columns {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-xl);
    }
    .fit-col--yes {
      padding-right: var(--space-xl);
      border-right: 1px solid var(--color-border);
    }
    .why-strip__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .assess-block {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-3xl);
    }
    .assess-block__paths {
      padding-top: 0;
      padding-left: var(--space-2xl);
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
    .capability-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .why-strip__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

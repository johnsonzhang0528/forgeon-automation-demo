---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import VisionX2Signature from '../../components/sections/VisionX2Signature.astro';
import IndustrialReality from '../../components/sections/IndustrialReality.astro';
import IntegrationLogic from '../../components/sections/IntegrationLogic.astro';
import HomeFinalCTA from '../../components/sections/HomeFinalCTA.astro';
import { getSortedProducts } from '../../utils/content';
import '../../styles/home-refinement.css';

const locale = 'zh-tw' as const;

const products = await getSortedProducts();

/*
 * Phase 5C — Core Capability Production Reconstruction.
 * The three canonical capabilities each anchor to their real product
 * entry (Canonical Project Truth from src/content/products/*.md —
 * `positioning` and `shortDescription`, not invented copy). Pulled from
 * the already-loaded `products` collection rather than hardcoded strings,
 * so this stays in sync if product content changes. FLEXCELL-M has no
 * detail page yet (hasDetailPage: false) — its row links to /products/
 * (the listing) instead of a nonexistent detail route, same fallback
 * ProductCard already uses elsewhere on this page.
 */
const capabilityIndex = ['axm-400', 'vision-x2', 'flexcell-m'] as const;
const capabilities = capabilityIndex.map((slug) => {
  const product = products.find((p) => p.data.entrySlug === slug);
  if (!product) {
    throw new Error(`Core Capability index expects a "${slug}" product entry — none found.`);
  }
  return {
    slug,
    name: product.data.name,
    positioning: product.data.positioning['zh-tw'],
    description: product.data.shortDescription['zh-tw'],
    hasDetailPage: product.data.hasDetailPage,
  };
});

const processSteps = [
  { title: '需求釐清', description: '了解製程背景、現有設備介面與導入目標，確認初步可行性。' },
  { title: '方案評估', description: '依工件、節拍與空間條件，提出運動、視覺或整合方案的技術評估。' },
  { title: '設計與報價', description: '完成機構與系統設計，提供正式技術方案與報價。' },
  { title: '製作與測試', description: '模組製作、系統整合與內部功能測試，確認符合設計條件。' },
  { title: '導入與驗收', description: '現場安裝、調整與驗收，並提供操作與維護說明。' },
];
---

<BaseLayout
  locale={locale}
  path="/zh-tw/"
  otherLocalePath="/en/"
  title="鋒岳自動化｜精密運動與視覺整合的工業自動化方案"
  description="鋒岳自動化是虛構的工業自動化品牌概念案例，展示精密運動、視覺定位與自動化組裝整合的網站策略與工程資訊架構。"
  bodyClass="home-dark-ending"
>
  <!-- Hero -->
  <Hero locale={locale} />

  <!-- Core Capability — Engineering Capability Chain (HP-REC-02, revising
       Phase 5C). The three capabilities are no longer three equal-weight
       rows read top-to-bottom like a spec table — they are staged left to
       right (desktop) / top to bottom (mobile) as one connected chain:
       motion establishes the base, vision adds a judgment layer on top of
       it, integration synthesizes both into a deployable system. A single
       connector line threads through all three stage markers so the
       relationship is visible before any copy is read, not just asserted
       in the intro paragraph. No cards, no icon grid, no dashboard
       styling — still typography/grid/spacing only (DESIGN.md v2
       Precision Instrument Editorial direction), same as the section it
       replaces. -->
  <section class="section-standard capability-section">
    <div class="container">
      <div class="capability-intro">
        <p class="capability-intro__eyebrow mono">核心能力</p>
        <h2 class="capability-intro__title">從精密運動到系統整合</h2>
      </div>

      <ol class="capability-chain">
        {capabilities.map((cap, i) => (
          <li class="capability-stage" data-stage={i + 1}>
            <div class="capability-stage__marker" aria-hidden="true">
              <span class="capability-stage__index mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="capability-stage__body">
              <p class="capability-stage__role mono">
                {i === 0 ? '基礎動作' : i === 1 ? '判斷依據' : '可部署系統'}
              </p>
              <h3 class="capability-stage__name">{cap.positioning}</h3>
              <p class="capability-stage__desc">{cap.description}</p>
              <a href={`/${locale}/products/${cap.slug}/`} class="capability-stage__link">
                <span class="capability-stage__model mono">{cap.name}</span>
                <span class="capability-stage__arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- VISION-X2 Featured Product / Signature Moment (Phase 5D). -->
  <VisionX2Signature locale={locale} />

  <!-- Industrial Reality Check — third Homepage Signature Moment (Phase 5E). -->
  <IndustrialReality locale={locale} />

  <!-- Integration / Deployment Logic (Phase 5F). -->
  <IntegrationLogic locale={locale} steps={processSteps} />

  <!-- Final CTA (Phase 5G). -->
  <HomeFinalCTA locale={locale} />
</BaseLayout>

<style>
  /* CTA banner and Footer share the same dark ink background — remove the
     Footer's default top margin only on this page so the two read as one
     continuous dark ending rather than a dark card floating in white space
     before another dark block (P1-4, docs/uiux-upgrade/09-product-plate-
     and-ending.md). Footer.astro is a child component with its own Astro
     scope hash, so this must be :global() to reach the rendered <footer>
     node (same reason Header.astro's own CSS documents for
     .site-header__cta). Scoped via the page's own bodyClass rather than a
     :has() selector, and rather than editing Footer.astro's default
     margin, which is shared by every other page. */
  :global(body.home-dark-ending .site-footer) {
    margin-top: 0;
  }

  /*
   * Core Capability — Engineering Capability Chain (HP-REC-02).
   * Scoped Direction-B accent, same pattern as Header.astro/Hero.astro:
   * the sitewide --color-accent still belongs to the superseded Precision
   * Datum System (DESIGN.md v2 §0), so this section defines its own
   * locally-cascading override rather than touching tokens.css — every
   * other section on this page keeps the current sitewide accent until a
   * later ticket migrates it deliberately.
   */
  .capability-section {
    --color-accent: #3d5a6c;
    --color-accent-dark: #24404f;
  }

  .capability-intro {
    margin-bottom: var(--space-2xl);
  }
  .capability-intro__eyebrow {
    margin: 0 0 var(--space-2xs);
    color: var(--color-accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .capability-intro__title {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  /*
   * The chain: three stages connected by one continuous line, not three
   * independent rows. Mobile-first — base rules are the vertical stack
   * (connector runs top-to-bottom through each stage's index marker);
   * the desktop enhancement below turns it horizontal. The connector is
   * drawn once per stage as a border edge on the marker column so it
   * reads as a single unbroken line across all three stages, not three
   * separate short lines that happen to touch.
   */
  .capability-chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .capability-stage {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0 var(--space-lg);
  }

  .capability-stage__marker {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .capability-stage__marker::before {
    /* the connector line itself, running the full height of this stage */
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--color-border-strong);
  }
  .capability-stage:first-child .capability-stage__marker::before {
    top: 1.4em;
  }
  .capability-stage:last-child .capability-stage__marker::before {
    bottom: calc(100% - 1.4em);
  }
  .capability-stage__index {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.15em;
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .capability-stage__body {
    padding-block: var(--space-lg);
  }
  .capability-stage:first-child .capability-stage__body {
    padding-top: 0;
  }
  .capability-stage:last-child .capability-stage__body {
    padding-bottom: 0;
  }

  .capability-stage__role {
    margin: 0 0 0.35em;
    color: var(--color-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .capability-stage__name {
    margin: 0 0 var(--space-2xs);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  /* First stage anchors the chain — establishes the base, reads larger
     than the two stages built on top of it. */
  .capability-stage:first-child .capability-stage__name {
    font-size: var(--fs-xl);
  }
  .capability-stage__desc {
    margin: 0 0 var(--space-sm);
    max-width: 42em;
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-body-lg);
  }

  .capability-stage__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    color: var(--color-ink);
  }
  .capability-stage__model {
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .capability-stage__arrow {
    color: var(--color-accent);
    transition: transform var(--duration-ui) var(--ease-standard);
  }
  .capability-stage__link:hover {
    color: var(--color-accent-dark);
  }
  .capability-stage__link:hover .capability-stage__arrow {
    transform: translateX(3px);
  }

  @media (min-width: 900px) {
    .capability-intro {
      max-width: 34em;
    }

    /*
     * Desktop: the chain turns horizontal. Each stage becomes a column;
     * the connector becomes ONE continuous horizontal rule drawn once on
     * the .capability-chain container itself (not three per-stage
     * segments broken up by the inter-stage gap) so it reads as a single
     * unbroken line threading through all three index markers. Stage 1
     * (motion) is deliberately the widest column and carries the largest
     * type — it is the foundation the other two stages are staged on top
     * of, not an equal partner.
     */
    .capability-chain {
      position: relative;
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-xl);
    }
    .capability-chain::before {
      content: '';
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      right: 1.25rem;
      height: 1px;
      background: var(--color-border-strong);
    }
    .capability-stage {
      grid-template-columns: 1fr;
      grid-template-rows: 2.5rem auto;
      flex: 1;
    }
    .capability-stage:first-child {
      flex: 1.15;
    }

    .capability-stage__marker {
      justify-content: flex-start;
    }
    .capability-stage__marker::before {
      display: none;
    }
    .capability-stage__index {
      margin-top: 0;
    }

    .capability-stage__body {
      padding-block: 0;
      padding-top: var(--space-lg);
    }
    .capability-stage:first-child .capability-stage__body,
    .capability-stage:last-child .capability-stage__body {
      padding: var(--space-lg) 0 0;
    }
  }
</style>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../../components/navigation/Breadcrumb.astro';
import FeatureList from '../../../../components/ui/FeatureList.astro';
import ProcessTimeline from '../../../../components/ui/ProcessTimeline.astro';
import FAQAccordion from '../../../../components/ui/FAQAccordion.astro';
import CTABanner from '../../../../components/sections/CTABanner.astro';
import VisionGuidedAssemblyVisual from '../../../../components/sections/VisionGuidedAssemblyVisual.astro';
import ExistingLineRetrofitVisual from '../../../../components/sections/ExistingLineRetrofitVisual.astro';
import MachineVisionInspectionVisual from '../../../../components/sections/MachineVisionInspectionVisual.astro';
import PrecisionHandlingVisual from '../../../../components/sections/PrecisionHandlingVisual.astro';
import FieldCommissioningVisual from '../../../../components/sections/FieldCommissioningVisual.astro';
import SystemArchitectureDiagram from '../../../../components/sections/SystemArchitectureDiagram.astro';
import Badge from '../../../../components/ui/Badge.astro';
import ProductCard from '../../../../components/ui/ProductCard.astro';
import StructuredData from '../../../../components/seo/StructuredData.astro';
import { getSortedSolutions, getSortedProducts } from '../../../../utils/content';

export async function getStaticPaths() {
  const solutions = await getSortedSolutions();
  return solutions.map((s) => ({ params: { slug: s.data.entrySlug }, props: { solution: s } }));
}

const { solution } = Astro.props;
const locale = 'zh-tw' as const;
const d = solution.data;
const allProducts = await getSortedProducts();
const compatibleProducts = allProducts.filter((p) => d.compatibleProducts.includes(p.data.entrySlug));
const isFullDetail = d.hasDetailPage;

const path = `/zh-tw/solutions/${d.entrySlug}/`;
const otherLocalePath = `/en/solutions/${d.entrySlug}/`;
---

<BaseLayout
  locale={locale}
  path={path}
  otherLocalePath={otherLocalePath}
  title={d.seoTitle['zh-tw']}
  description={d.seoDescription['zh-tw']}
>
  {isFullDetail && d.faq && (
    <StructuredData
      breadcrumbs={[
        { name: '解決方案', path: '/zh-tw/solutions/' },
        { name: d.name['zh-tw'], path },
      ]}
      faq={d.faq.map((f) => ({ question: f.question['zh-tw'], answer: f.answer['zh-tw'] }))}
    />
  )}
  {!isFullDetail && (
    <StructuredData breadcrumbs={[{ name: '解決方案', path: '/zh-tw/solutions/' }, { name: d.name['zh-tw'], path }]} />
  )}

  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: '解決方案', path: '/zh-tw/solutions/' }, { label: d.name['zh-tw'], path }]} />
  </div>

  <section class="section section--tight">
    <div class="container container--narrow">
      <Badge variant="demo">概念展示內容</Badge>
      <h1 class="detail-title">{d.name['zh-tw']}</h1>
      <p class="detail-summary measure">{d.heroSummary['zh-tw']}</p>
      {d.entrySlug === 'vision-guided-assembly' && (
        <VisionGuidedAssemblyVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'line-upgrade' && (
        <ExistingLineRetrofitVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'vision-inspection' && (
        <MachineVisionInspectionVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'precision-positioning' && (
        <PrecisionHandlingVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'custom-integration' && (
        <FieldCommissioningVisual locale={locale} presentation="wide" priority />
      )}
    </div>
  </section>

  <section class="section section--tight section--alt">
    <div class="container container--narrow two-col">
      <div>
        <h2>常見問題</h2>
        <p>{d.problem['zh-tw']}</p>
      </div>
      <div>
        <h2>解決方式</h2>
        <p>{d.approach['zh-tw']}</p>
      </div>
    </div>
  </section>

  {d.entrySlug === 'line-upgrade' && (
    <section class="section section--tight">
      <div class="container">
        <SystemArchitectureDiagram locale={locale} variant="line-upgrade" />
      </div>
    </section>
  )}

  {isFullDetail && d.background && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <SectionHeading eyebrow="背景說明" title="為什麼需要視覺定位" />
        <p class="measure">{d.background['zh-tw']}</p>
      </div>
    </section>
  )}

  {isFullDetail && d.scenarios && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="適用情境" title="什麼情況下適合這套方案" />
        <FeatureList items={d.scenarios['zh-tw']} />
      </div>
    </section>
  )}

  {isFullDetail && d.systemComponents && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeading eyebrow="系統組成" title="方案包含哪些系統元件" />
        <SystemArchitectureDiagram locale={locale} variant="vision-guided-assembly" headingLevel="h3" />
        <div class="system-components-list">
          <FeatureList items={d.systemComponents['zh-tw']} />
        </div>
      </div>
    </section>
  )}

  {isFullDetail && d.workflow && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="作業流程" title="運作方式" />
        <ProcessTimeline
          steps={d.workflow.map((w) => ({ title: w.title['zh-tw'], description: w.description['zh-tw'] }))}
        />
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container container--narrow two-col">
      <div>
        <h2>主要效益</h2>
        <FeatureList items={d.keyBenefits['zh-tw']} />
      </div>
      <div>
        <h2>適用產業</h2>
        <ul class="plain-list">
          {d.applicableIndustries['zh-tw'].map((ind) => <li>{ind}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {isFullDetail && d.integrableEquipment && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="可整合設備" title="相容的設備類型" />
        <FeatureList items={d.integrableEquipment['zh-tw']} />
      </div>
    </section>
  )}

  {isFullDetail && d.advantages && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <SectionHeading eyebrow="主要優勢" title="這套方案的優勢" />
        <FeatureList items={d.advantages['zh-tw']} />
      </div>
    </section>
  )}

  {isFullDetail && d.prerequisites && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="導入前準備" title="開始評估前，建議先準備" />
        <FeatureList items={d.prerequisites['zh-tw']} />
      </div>
    </section>
  )}

  {isFullDetail && d.entrySlug === 'vision-guided-assembly' && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <SectionHeading eyebrow="適合評估" title="這套方案適合／不適合什麼情況" />
        <div class="fit-grid">
          <div class="fit-card fit-card--yes">
            <h3>適合的情況</h3>
            <ul>
              <li>工件公差偏移或來料方向不固定，固定機構治具已無法穩定對位</li>
              <li>同一產線需生產多款式，且款式間需要快速切換辨識參數</li>
              <li>希望在組裝的同時完成外觀或特徵檢測，減少站點數量</li>
              <li>已能提供工件實際尺寸圖與公差範圍，可供工程團隊評估相機與光源配置</li>
            </ul>
          </div>
          <div class="fit-card fit-card--no">
            <h3>暫時不適合的情況</h3>
            <ul>
              <li>工件材質為高反光或透明特性，且尚未確認可用的特殊光源方案</li>
              <li>現場光線環境劇烈變動，且無法調整或加裝穩定光源</li>
              <li>僅需單一固定款式、公差極小的定位需求，固定機構治具可能已足夠，不需要視覺系統的額外成本</li>
              <li>尚未確認現場空間是否足以安裝相機與光源模組</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {isFullDetail && d.entrySlug === 'vision-guided-assembly' && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="示範專案情境 · Concept Scenario" title="一個虛構的專案情境示範" description="以下情境為完全虛構的示範內容，用於展示從問題到交付的完整流程，不代表任何真實客戶或專案。" />
        <div class="scenario-block">
          <div class="scenario-item">
            <h3>虛構問題背景</h3>
            <p>一間虛構的電子代工廠在既有產線上以固定治具進行連接器組裝，近期因供應商調整導致來料方向不再一致，固定治具的對位失敗率明顯上升，產線主管需要評估是否導入視覺定位。</p>
          </div>
          <div class="scenario-item">
            <h3>使用者角色</h3>
            <p>製程工程師負責提供工件圖面與產線節拍資料；採購窗口負責確認預算區間與導入時程；兩者皆可能是實際送出 RFQ 表單的角色。</p>
          </div>
          <div class="scenario-item">
            <h3>資料輸入</h3>
            <p>工件尺寸圖、目前產線節拍時間、既有治具是否可沿用、現場光線環境描述、目標良率。</p>
          </div>
          <div class="scenario-item">
            <h3>方案選擇</h3>
            <p>依據上述輸入，評估方向為視覺定位自動化組裝方案，搭配 VISION-X2 負責辨識與定位、AXM-400 負責後續對位運動。</p>
          </div>
          <div class="scenario-item">
            <h3>交付物（示範用途，非真實承諾）</h3>
            <p>技術評估報告、系統架構圖、初步報價區間、建議導入時程。這些項目為示範本站 RFQ 流程「應該收集到什麼資訊、應該產出什麼」的參考，不代表任何真實交付紀錄。</p>
          </div>
          <div class="scenario-item">
            <h3>驗收方式（示範用途）</h3>
            <p>依約定的定位精度與良率指標進行現場測試驗收，測試結果與現場條件相關，實際指標由專案合約另行約定，本頁不做預先承諾。</p>
          </div>
        </div>
        <p class="scenario-disclaimer">本情境不包含任何真實成果百分比、營收數字或客戶推薦內容，純粹用於展示網站資訊架構與 RFQ 流程設計。</p>
      </div>
    </section>
  )}

  {compatibleProducts.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeading eyebrow="可搭配產品" title="相關產品" />
        <div class="grid-auto">
          {compatibleProducts.map((p) => (
            <ProductCard
              locale={locale}
              slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
              name={p.data.name}
              positioning={p.data.positioning['zh-tw']}
              description={p.data.shortDescription['zh-tw']}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {isFullDetail && d.faq && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="常見問題" title="FAQ" />
        <FAQAccordion
          idPrefix="solution-faq"
          items={d.faq.map((f) => ({ question: f.question['zh-tw'], answer: f.answer['zh-tw'] }))}
        />
      </div>
    </section>
  )}

  <div class="container">
    <CTABanner locale={locale} title="想進一步討論這套方案？" description="提交您的製程背景，工程團隊會協助評估可行性。" />
  </div>
</BaseLayout>

<style>
  .detail-title {
    margin: var(--space-sm) 0 var(--space-md);
  }
  .detail-summary {
    color: var(--color-muted);
    font-size: var(--fs-md);
  }
  .container--narrow {
    max-width: 860px;
  }
  .system-components-list {
    max-width: 860px;
    margin: var(--space-xl) auto 0;
  }
  .two-col {
    display: grid;
    gap: var(--space-xl);
  }
  .two-col h2 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-sm);
  }
  .two-col p {
    color: var(--color-muted);
    margin: 0;
  }
  .fit-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .fit-card {
    background: var(--color-card);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    border-top: 3px solid var(--color-border-strong);
  }
  .fit-card--yes {
    border-top-color: var(--color-success);
  }
  .fit-card--no {
    border-top-color: var(--color-muted);
  }
  .fit-card h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-md);
  }
  .fit-card ul {
    margin: 0;
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .fit-card li {
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  @media (min-width: 720px) {
    .fit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .scenario-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .scenario-item {
    padding: var(--space-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .scenario-item h3 {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0 0 var(--space-2xs);
  }
  .scenario-item p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  .scenario-disclaimer {
    margin-top: var(--space-md);
    font-size: var(--fs-xs);
    color: var(--color-muted);
    font-style: italic;
  }
  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
  }
  .plain-list li {
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-accent-light);
  }
  @media (min-width: 720px) {
    .two-col {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script define:vars={{ slug: d.entrySlug, locale }}>
  // solution_view was defined in src/utils/analytics.ts but never actually
  // fired anywhere (spec 4.2) — this is the fix.
  window.dispatchEvent(new CustomEvent('forgeon:analytics', {
    detail: { event: 'solution_view', payload: { slug, locale } },
  }));
</script>

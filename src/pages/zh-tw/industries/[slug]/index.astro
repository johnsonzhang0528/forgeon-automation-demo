---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../../components/navigation/Breadcrumb.astro';
import FeatureList from '../../../../components/ui/FeatureList.astro';
import IndustryIcon from '../../../../components/ui/IndustryIcon.astro';
import Badge from '../../../../components/ui/Badge.astro';
import SolutionCard from '../../../../components/ui/SolutionCard.astro';
import ProductCard from '../../../../components/ui/ProductCard.astro';
import CTABanner from '../../../../components/sections/CTABanner.astro';
import StructuredData from '../../../../components/seo/StructuredData.astro';
import { getSortedIndustries, getSortedSolutions, getSortedProducts } from '../../../../utils/content';

export async function getStaticPaths() {
  const industries = await getSortedIndustries();
  return industries.map((ind) => ({ params: { slug: ind.data.entrySlug }, props: { industry: ind } }));
}

const { industry } = Astro.props;
const locale = 'zh-tw' as const;
const d = industry.data;
const allSolutions = await getSortedSolutions();
const allProducts = await getSortedProducts();
const suitableSolutions = allSolutions.filter((s) => d.suitableSolutions.includes(s.data.entrySlug));
const relatedProducts = allProducts.filter((p) => d.relatedProducts.includes(p.data.entrySlug));

const path = `/zh-tw/industries/${d.entrySlug}/`;
const otherLocalePath = `/en/industries/${d.entrySlug}/`;
---

<BaseLayout locale={locale} path={path} otherLocalePath={otherLocalePath} title={d.seoTitle['zh-tw']} description={d.seoDescription['zh-tw']}>
  <StructuredData breadcrumbs={[{ name: '產業應用', path: '/zh-tw/industries/' }, { name: d.name['zh-tw'], path }]} />

  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: '產業應用', path: '/zh-tw/industries/' }, { label: d.name['zh-tw'], path }]} />
  </div>

  <section class="section section--tight">
    <div class="container industry-hero">
      <IndustryIcon industry={d.entrySlug as any} class="industry-hero__icon" />
      <div>
        <Badge variant="demo">概念展示內容</Badge>
        <h1 class="industry-hero__title">{d.name['zh-tw']}</h1>
        <p class="industry-hero__desc measure">{d.shortDescription['zh-tw']}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--alt">
    <div class="container container--narrow">
      <SectionHeading eyebrow="常見製程問題" title="這個產業常遇到的挑戰" />
      <FeatureList items={d.commonProblems['zh-tw']} />
    </div>
  </section>

  {suitableSolutions.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeading eyebrow="適合的解決方案" title="建議的自動化方向" />
        <div class="grid-auto">
          {suitableSolutions.map((s) => (
            <SolutionCard
              locale={locale}
              slug={s.data.entrySlug}
              name={s.data.name['zh-tw']}
              description={s.data.shortDescription['zh-tw']}
              hasDetailPage={s.data.hasDetailPage}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedProducts.length > 0 && (
    <section class="section section--tight section--alt">
      <div class="container">
        <SectionHeading eyebrow="相關產品" title="可搭配的產品" />
        <div class="grid-auto">
          {relatedProducts.map((p) => (
            <ProductCard
              locale={locale}
              slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
              name={p.data.name}
              positioning={p.data.positioning['zh-tw']}
              description={p.data.shortDescription['zh-tw']}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container container--narrow">
      <SectionHeading eyebrow="導入前準備" title="評估前建議準備的資訊" />
      <FeatureList items={d.prerequisites['zh-tw']} />
    </div>
  </section>

  <div class="container">
    <CTABanner locale={locale} title="想討論這個產業的自動化方案？" description="提交您的製程背景，我們會協助評估可行的方向。" />
  </div>
</BaseLayout>

<style>
  .industry-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .industry-hero__icon {
    width: 56px;
    height: 56px;
  }
  .industry-hero__title {
    margin: var(--space-sm) 0 var(--space-sm);
  }
  .industry-hero__desc {
    color: var(--color-muted);
    font-size: var(--fs-md);
  }
  .container--narrow {
    max-width: 860px;
  }
</style>

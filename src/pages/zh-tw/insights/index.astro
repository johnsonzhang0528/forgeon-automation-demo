---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import Card from '../../../components/ui/Card.astro';
import { getSortedInsights } from '../../../utils/content';
import { getDictionary } from '../../../utils/i18n';

const locale = 'zh-tw' as const;
const dict = getDictionary(locale);
const insights = await getSortedInsights(locale);

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
}
---

<BaseLayout
  locale={locale}
  path="/zh-tw/insights/"
  otherLocalePath="/en/insights/"
  title="技術資源｜鋒岳自動化"
  description="鋒岳自動化技術資源文章，說明自動化導入前的準備工作與產線升級的判斷方式，提供實際可用的參考資訊。"
>
  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: '技術資源', path: '/zh-tw/insights/' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="技術資源"
        title="自動化導入的實務參考"
        description="提供實際可用的技術資訊，協助評估自動化專案的準備工作與決策方向。"
      />
      <div class="insights-list">
        {insights.map((post) => (
          <Card href={`/zh-tw/insights/${post.data.entrySlug}/`} class="insight-card">
            <p class="insight-card__date mono">{formatDate(post.data.publishDate)}</p>
            <h2 class="insight-card__title">{post.data.title}</h2>
            <p class="insight-card__summary measure">{post.data.summary}</p>
            <span class="insight-card__link">{dict.misc.readMore}</span>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .insights-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .insight-card__date {
    color: var(--color-muted);
    font-size: var(--fs-xs);
    margin: 0;
  }
  .insight-card__title {
    font-size: var(--fs-xl);
    margin: var(--space-2xs) 0;
  }
  .insight-card__summary {
    color: var(--color-muted);
    margin: 0;
  }
  .insight-card__link {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-top: var(--space-2xs);
  }
</style>

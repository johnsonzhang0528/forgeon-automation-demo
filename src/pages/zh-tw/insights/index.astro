---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import InsightCard from '../../../components/ui/InsightCard.astro';
import { getSortedInsights } from '../../../utils/content';
import { getDictionary } from '../../../utils/i18n';

const locale = 'zh-tw' as const;
const dict = getDictionary(locale);
const insights = await getSortedInsights(locale);

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
}
---

<BaseLayout
  locale={locale}
  path="/zh-tw/insights/"
  otherLocalePath="/en/insights/"
  title="技術資源｜鋒岳自動化"
  description="鋒岳自動化技術資源文章，說明自動化導入前的準備工作與產線升級的判斷方式，提供實際可用的參考資訊。"
>
  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: '技術資源', path: '/zh-tw/insights/' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        level="h1"
        eyebrow="技術資源"
        title="自動化導入的實務參考"
        description="提供實際可用的技術資訊，協助評估自動化專案的準備工作與決策方向。"
      />
      <div class="insights-list">
        {insights.map((post) => (
          <InsightCard
            locale={locale}
            insight={post.data.entrySlug}
            href={`/zh-tw/insights/${post.data.entrySlug}/`}
            dateIso={post.data.publishDate.toISOString()}
            dateLabel={formatDate(post.data.publishDate)}
            title={post.data.title}
            summary={post.data.summary}
            linkLabel={dict.misc.readMore}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .insights-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .insights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

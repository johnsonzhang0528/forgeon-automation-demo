---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/navigation/Breadcrumb.astro';
import CTABanner from '../../../../components/sections/CTABanner.astro';
import InsightVisual from '../../../../components/ui/InsightVisual.astro';
import StructuredData from '../../../../components/seo/StructuredData.astro';
import { getSortedInsights } from '../../../../utils/content';
import { getDictionary } from '../../../../utils/i18n';

export async function getStaticPaths() {
  const insights = await getSortedInsights('zh-tw');
  return insights.map((post) => ({ params: { slug: post.data.entrySlug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const locale = 'zh-tw' as const;
const dict = getDictionary(locale);
const d = post.data;

const path = `/zh-tw/insights/${d.entrySlug}/`;
const otherLocalePath = `/en/insights/${d.entrySlug}/`;

function formatDate(dt: Date) {
  return new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }).format(dt);
}
---

<BaseLayout locale={locale} path={path} otherLocalePath={otherLocalePath} title={d.seoTitle} description={d.seoDescription}>
  <StructuredData
    breadcrumbs={[{ name: '技術資源', path: '/zh-tw/insights/' }, { name: d.title, path }]}
    article={{
      headline: d.title,
      description: d.summary,
      datePublished: d.publishDate.toISOString(),
      path,
    }}
  />

  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: '技術資源', path: '/zh-tw/insights/' }, { label: d.title, path }]} />
  </div>

  <article class="section section--tight">
    <div class="container container--narrow">
      <p class="article-date mono">{dict.misc.publishedOn}：{formatDate(d.publishDate)}</p>
      <h1 class="article-title">{d.title}</h1>
      <InsightVisual locale={locale} insight={d.entrySlug} placement="hero" priority />
      <div class="article-body">
        <Content />
      </div>
    </div>
  </article>

  <div class="container">
    <CTABanner locale={locale} title="想討論您自己的專案背景？" description="提交需求說明，工程團隊會協助評估。" />
  </div>
</BaseLayout>

<style>
  .container--narrow {
    max-width: 760px;
  }
  .article-date {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-sm);
  }
  .article-title {
    max-width: 18ch;
    margin: 0 0 clamp(var(--space-lg), 5vw, var(--space-16));
    text-wrap: balance;
  }
</style>

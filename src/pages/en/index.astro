---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import VisionX2Signature from '../../components/sections/VisionX2Signature.astro';
import IndustrialReality from '../../components/sections/IndustrialReality.astro';
import IntegrationLogic from '../../components/sections/IntegrationLogic.astro';
import HomeFinalCTA from '../../components/sections/HomeFinalCTA.astro';
import { getSortedProducts } from '../../utils/content';
import '../../styles/home-refinement.css';

const locale = 'en' as const;

const products = await getSortedProducts();

/*
 * Phase 5C — Core Capability Production Reconstruction (English mirror of
 * zh-tw/index.astro's same block — see that file's comment for the full
 * rationale: real product content, no invented copy).
 */
const capabilityIndex = ['axm-400', 'vision-x2', 'flexcell-m'] as const;
const capabilities = capabilityIndex.map((slug) => {
  const product = products.find((p) => p.data.entrySlug === slug);
  if (!product) {
    throw new Error(`Core Capability index expects a "${slug}" product entry — none found.`);
  }
  return {
    slug,
    name: product.data.name,
    positioning: product.data.positioning.en,
    description: product.data.shortDescription.en,
    hasDetailPage: product.data.hasDetailPage,
  };
});

const processSteps = [
  { title: 'Requirements Discovery', description: 'Understand the process background, existing equipment interfaces, and implementation goals to confirm initial feasibility.' },
  { title: 'Solution Evaluation', description: 'Provide a technical evaluation of motion, vision, or integration approaches based on part geometry, takt time, and floor space.' },
  { title: 'Design & Quotation', description: 'Complete mechanical and system design, then deliver a formal technical proposal and quotation.' },
  { title: 'Build & Testing', description: 'Module fabrication, system integration, and internal functional testing against the design spec.' },
  { title: 'Deployment & Acceptance', description: 'On-site installation, commissioning, and acceptance testing, with operating and maintenance documentation.' },
];
---

<BaseLayout
  locale={locale}
  path="/en/"
  otherLocalePath="/zh-tw/"
  title="FORGEON AUTOMATION | Precision Motion & Vision Integration for Industrial Automation"
  description="FORGEON AUTOMATION is a fictional industrial automation brand concept demonstrating precision motion, vision-guided positioning, automated assembly, and engineering-led information architecture."
>
  <!-- Hero -->
  <Hero locale={locale} />

  <!-- Core Capability — Engineering Capability Chain (HP-REC-02, revising
       Phase 5C). See zh-tw/index.astro's equivalent block for the full
       design rationale. -->
  <section class="section-standard capability-section">
    <div class="container">
      <div class="capability-intro">
        <p class="capability-intro__eyebrow mono">Core Capability</p>
        <h2 class="capability-intro__title">From Precision Motion to System Integration</h2>
      </div>

      <ol class="capability-chain">
        {capabilities.map((cap, i) => (
          <li class="capability-stage" data-stage={i + 1}>
            <div class="capability-stage__marker" aria-hidden="true">
              <span class="capability-stage__index mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="capability-stage__body">
              <p class="capability-stage__role mono">
                {i === 0 ? 'Base Movement' : i === 1 ? 'Judgment Layer' : 'Deployable System'}
              </p>
              <h3 class="capability-stage__name">{cap.positioning}</h3>
              <p class="capability-stage__desc">{cap.description}</p>
              <a href={`/${locale}/products/${cap.slug}/`} class="capability-stage__link">
                <span class="capability-stage__model mono">{cap.name}</span>
                <span class="capability-stage__arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- VISION-X2 Featured Product / Signature Moment (Phase 5D). -->
  <VisionX2Signature locale={locale} />

  <!-- Industrial Reality Check — third Homepage Signature Moment (Phase 5E). -->
  <IndustrialReality locale={locale} />

  <!-- Integration / Deployment Logic (Phase 5F). -->
  <IntegrationLogic locale={locale} steps={processSteps} />

  <!-- Final CTA (Phase 5G). -->
  <HomeFinalCTA locale={locale} />
</BaseLayout>

<style>
  /*
   * Core Capability — Engineering Capability Chain (HP-REC-02). Scoped
   * Direction-B accent, same pattern as Header.astro/Hero.astro/the
   * zh-tw homepage's equivalent block — see zh-tw/index.astro's comment
   * for the full rationale.
   */
  .capability-section {
    --color-accent: #3d5a6c;
    --color-accent-dark: #24404f;
  }

  .capability-intro {
    margin-bottom: var(--space-2xl);
  }
  .capability-intro__eyebrow {
    margin: 0 0 var(--space-2xs);
    color: var(--color-accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .capability-intro__title {
    margin: 0;
    max-width: 24ch;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .capability-chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .capability-stage {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0 var(--space-lg);
  }

  .capability-stage__marker {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .capability-stage__marker::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--color-border-strong);
  }
  .capability-stage:first-child .capability-stage__marker::before {
    top: 1.4em;
  }
  .capability-stage:last-child .capability-stage__marker::before {
    bottom: calc(100% - 1.4em);
  }
  .capability-stage__index {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.15em;
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .capability-stage__body {
    padding-block: var(--space-lg);
  }
  .capability-stage:first-child .capability-stage__body {
    padding-top: 0;
  }
  .capability-stage:last-child .capability-stage__body {
    padding-bottom: 0;
  }

  .capability-stage__role {
    margin: 0 0 0.35em;
    color: var(--color-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .capability-stage__name {
    margin: 0 0 var(--space-2xs);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  .capability-stage:first-child .capability-stage__name {
    font-size: var(--fs-xl);
  }
  .capability-stage__desc {
    margin: 0 0 var(--space-sm);
    max-width: 42em;
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-body-lg);
  }

  .capability-stage__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    color: var(--color-ink);
  }
  .capability-stage__model {
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .capability-stage__arrow {
    color: var(--color-accent);
    transition: transform var(--duration-ui) var(--ease-standard);
  }
  .capability-stage__link:hover {
    color: var(--color-accent-dark);
  }
  .capability-stage__link:hover .capability-stage__arrow {
    transform: translateX(3px);
  }

  @media (min-width: 900px) {
    .capability-intro {
      max-width: 34em;
    }

    .capability-chain {
      position: relative;
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-xl);
    }
    .capability-chain::before {
      content: '';
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      right: 1.25rem;
      height: 1px;
      background: var(--color-border-strong);
    }
    .capability-stage {
      grid-template-columns: 1fr;
      grid-template-rows: 2.5rem auto;
      flex: 1;
    }
    .capability-stage:first-child {
      flex: 1.15;
    }

    .capability-stage__marker {
      justify-content: flex-start;
    }
    .capability-stage__marker::before {
      display: none;
    }
    .capability-stage__index {
      margin-top: 0;
    }

    .capability-stage__body {
      padding-block: 0;
      padding-top: var(--space-lg);
    }
    .capability-stage:first-child .capability-stage__body,
    .capability-stage:last-child .capability-stage__body {
      padding: var(--space-lg) 0 0;
    }
  }
</style>

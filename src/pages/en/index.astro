---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import HeroIllustration from '../../components/ui/HeroIllustration.astro';
import SolutionCard from '../../components/ui/SolutionCard.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import IndustryCard from '../../components/ui/IndustryCard.astro';
import ProcessTimeline from '../../components/ui/ProcessTimeline.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import { getSortedSolutions, getSortedProducts, getSortedIndustries } from '../../utils/content';

const locale = 'en' as const;

const solutions = (await getSortedSolutions()).slice(0, 3);
const products = await getSortedProducts();
const industries = await getSortedIndustries();

const processSteps = [
  { title: 'Requirements Discovery', description: 'Understand the process background, existing equipment interfaces, and implementation goals to confirm initial feasibility.' },
  { title: 'Solution Evaluation', description: 'Provide a technical evaluation of motion, vision, or integration approaches based on part geometry, takt time, and floor space.' },
  { title: 'Design & Quotation', description: 'Complete mechanical and system design, then deliver a formal technical proposal and quotation.' },
  { title: 'Build & Testing', description: 'Module fabrication, system integration, and internal functional testing against the design spec.' },
  { title: 'Deployment & Acceptance', description: 'On-site installation, commissioning, and acceptance testing, with operating and maintenance documentation.' },
];

const whyReasons = [
  { title: 'Engineering-Led Process', desc: 'Every proposal starts from an actual process problem; feasibility is confirmed before design begins, not promised in advance.' },
  { title: 'Modular Product Line', desc: 'Motion, vision, and assembly modules can be deployed standalone or combined, scaled to project size.' },
  { title: 'Structured Technical Documentation', desc: 'Specifications, options, and prerequisites are documented for easy internal evaluation and comparison.' },
  { title: 'Cross-Border Project Experience', desc: 'Bilingual technical points of contact reduce specification misalignment on international projects.' },
];
---

<BaseLayout
  locale={locale}
  path="/en/"
  otherLocalePath="/zh-tw/"
  title="FORGEON AUTOMATION | Precision Motion & Vision Integration for Industrial Automation"
  description="FORGEON AUTOMATION provides precision linear modules, vision-guided inspection, and automated assembly integration for semiconductor, automotive, metal machining, and packaging & logistics production lines."
>
  <!-- Hero -->
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">Industrial Automation · Precision Motion &amp; Vision Integration</p>
        <h1 class="hero__title">Precision in motion. Efficiency in production.</h1>
        <p class="hero__desc measure">
          FORGEON AUTOMATION integrates precision linear modules, vision-guided inspection, and
          assembly work cells to help factories address positioning, inspection, and repetitive
          assembly challenges. From single-station upgrades to full line integration, every
          proposal is built from your actual process conditions.
        </p>
        <div class="hero__actions">
          <Button href="/en/contact/?intent=project" size="lg" trackEvent="cta_click" data-intent="project" data-source="home-hero">Discuss Your Project</Button>
          <Button href="/en/contact/?intent=technical-advice" variant="secondary" size="lg" trackEvent="cta_click" data-intent="technical-advice" data-source="home-hero">Request Technical Advice</Button>
        </div>
        <p class="hero__note">Portfolio concept site. Company and products are fictional.</p>
      </div>
      <div class="hero__visual">
        <HeroIllustration />
      </div>
    </div>
  </section>

  <!-- Capability overview -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="Core Capabilities"
        title="From Precision Motion to Full Integration"
        description="FORGEON AUTOMATION's capability spans motion module design, vision-guided inspection, and plant integration engineering, deployed as a single module or a complete solution."
      />
      <div class="capability-grid">
        <div class="capability-item">
          <span class="capability-item__index mono">01</span>
          <h3>Precision Linear Motion Modules</h3>
          <p>High-rigidity structures paired with servo drives deliver the repeatable accuracy machining, inspection, and assembly stations need.</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">02</span>
          <h3>Vision Positioning & Inspection</h3>
          <p>Industrial cameras and image algorithms handle workpiece positioning, defect detection, and barcode/feature recognition.</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">03</span>
          <h3>Automated Assembly Integration</h3>
          <p>Modular assembly cells with robotic arms and custom fixtures, suited to small-to-mid batch, multi-variant production.</p>
        </div>
        <div class="capability-item">
          <span class="capability-item__index mono">04</span>
          <h3>Existing Line Upgrades</h3>
          <p>Targeted automation at bottleneck stations improves throughput without a full line rebuild.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="Solutions"
        title="Automation Configured Around Your Process Challenge"
        description="From precision positioning to vision inspection, every solution starts from an actual process problem."
      />
      <div class="grid-auto">
        {solutions.map((s) => (
          <SolutionCard
            locale={locale}
            slug={s.data.entrySlug}
            name={s.data.name.en}
            description={s.data.shortDescription.en}
            hasDetailPage={s.data.hasDetailPage}
          />
        ))}
      </div>
      <div class="section-cta">
        <Button href="/en/solutions/" variant="secondary">View Solutions</Button>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section section--tight section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="Featured Products"
        title="A Modular Product Line"
        description="Three core products that deploy standalone or combine into a complete automated station."
      />
      <div class="grid-auto">
        {products.map((p) => (
          <ProductCard
            locale={locale}
            slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
            name={p.data.name}
            positioning={p.data.positioning.en}
            description={p.data.shortDescription.en}
          />
        ))}
      </div>
      <div class="section-cta">
        <Button href="/en/products/" variant="secondary">View Product Specs</Button>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="Industries"
        title="Industries We Serve"
        description="From semiconductor to packaging and logistics, each industry gets an automation approach suited to its process."
      />
      <div class="grid-auto">
        {industries.map((ind) => (
          <IndustryCard
            locale={locale}
            slug={ind.data.entrySlug as any}
            name={ind.data.name.en}
            description={ind.data.shortDescription.en}
            hasDetailPage={ind.data.hasDetailPage}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Fit / not-fit -->
  <section class="section section--tight section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="Fit Check"
        title="What FORGEON Fits, and What It Doesn't"
        description="Before submitting an RFQ, confirm your project actually falls in the range where we can add real value."
      />
      <div class="fit-grid">
        <div class="fit-card fit-card--yes">
          <h3>Good Fit</h3>
          <ul>
            <li>Machining, inspection, or assembly stations that need stable repeatable positioning, and you can already describe part dimensions and takt time</li>
            <li>Existing lines with a clear bottleneck station, where a localized automation upgrade makes more sense than a full rebuild</li>
            <li>Vision positioning or defect inspection needs where lighting and surface conditions are roughly defined</li>
            <li>Project scope that can support engineering evaluation and custom design, not a single standard-part purchase</li>
          </ul>
        </div>
        <div class="fit-card fit-card--no">
          <h3>Not a Fit Yet</h3>
          <ul>
            <li>You only need a single standard component, with no integration engineering or custom design required</li>
            <li>Process conditions aren't confirmed yet (part specs, takt time, and floor space are all still in flux); finish internal scoping first</li>
            <li>Your timeline can't accommodate a standard engineering evaluation cycle (e.g. a final proposal needed within two weeks)</li>
            <li>You need explosion-proof, cleanroom-grade, or other special environmental certification that hasn't been engineering-confirmed</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Two browsing paths -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="Start Here"
        title="Pick a Path Based on Your Role"
        description="Two common ways people arrive here, each with a different next step."
        align="center"
      />
      <div class="path-grid">
        <a href="/en/industries/" class="path-card">
          <span class="path-card__label">Overseas Procurement / Plant Managers</span>
          <h3>Confirm industry and capability fit first</h3>
          <p>Browse common process problems and suitable solutions by industry to quickly judge whether it's worth going deeper.</p>
          <span class="path-card__cta">Browse Industries →</span>
        </a>
        <a href="/en/products/" class="path-card">
          <span class="path-card__label">Automation / Process Engineers</span>
          <h3>Confirm product specs and system compatibility first</h3>
          <p>Go straight to full specification tables, options, and compatible solutions for all three core products to assess technical feasibility.</p>
          <span class="path-card__cta">Browse Products →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--tight section--alt">
    <div class="container container--narrow">
      <SectionHeading
        eyebrow="Implementation Process"
        title="From Requirements to On-Site Acceptance"
        description="A five-stage standard process that ensures every project receives a complete technical evaluation."
      />
      <ProcessTimeline steps={processSteps} />
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="Why FORGEON" title="Why Work With FORGEON AUTOMATION" align="center" />
      <div class="grid-auto">
        {whyReasons.map((r) => (
          <div class="why-item">
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <div class="container">
    <CTABanner
      locale={locale}
      title="Ready to discuss your automation project?"
      description="Submit your project background and requirements, and our engineering team will help evaluate a workable solution."
    />
  </div>
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(ellipse at top right, color-mix(in srgb, var(--color-accent) 6%, transparent), transparent 60%),
      var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-2xl);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
    margin: 0 0 var(--space-sm);
  }
  .hero__title {
    margin: 0 0 var(--space-md);
  }
  .hero__desc {
    color: var(--color-muted);
    font-size: var(--fs-md);
    margin: 0 0 var(--space-lg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }
  .hero__note {
    font-size: var(--fs-xs);
    color: var(--color-muted-soft);
    margin: 0;
  }
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .section--alt {
    background: var(--color-surface-alt);
  }

  .container--narrow {
    max-width: 860px;
  }

  .capability-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .capability-item {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .capability-item__index {
    color: var(--color-accent);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .capability-item h3 {
    margin: var(--space-2xs) 0;
    font-size: var(--fs-md);
  }
  .capability-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .section-cta {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
  }

  .why-item {
    text-align: center;
    padding: var(--space-lg);
  }
  .why-item h3 {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-2xs);
  }
  .why-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .fit-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .fit-card {
    background: var(--color-card);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    border-top: 3px solid var(--color-border-strong);
  }
  .fit-card--yes {
    border-top-color: var(--color-success);
  }
  .fit-card--no {
    border-top-color: var(--color-muted);
  }
  .fit-card h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-md);
  }
  .fit-card ul {
    margin: 0;
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .fit-card li {
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .path-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .path-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }
  .path-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .path-card__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }
  .path-card h3 {
    margin: var(--space-2xs) 0;
    font-size: var(--fs-lg);
  }
  .path-card p {
    margin: 0 0 var(--space-sm);
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }
  .path-card__cta {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-top: auto;
  }

  @media (min-width: 720px) {
    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .fit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .path-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .capability-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import ContactForm from '../../../components/forms/ContactForm.astro';
import { siteConfig } from '../../../config/site';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  path="/en/contact/"
  otherLocalePath="/zh-tw/contact/"
  title="Contact & Project Request Form | FORGEON AUTOMATION"
  description="Submit your automation project background and requirements, and the FORGEON AUTOMATION engineering team will help evaluate a solution. You can also reach our technical contact directly by email or phone."
>
  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: 'Contact', path: '/en/contact/' }]} />
  </div>

  <section class="section section--tight">
    <div class="container contact-layout">
      <div class="contact-layout__intro">
        <SectionHeading
          level="h1"
          eyebrow="Contact"
          title="Submit Your Project Request"
          description="Fill out the form below with your process background and requirements. This page demonstrates the full RFQ validation flow; as a portfolio demo, nothing you submit is sent or stored, and there is no reply commitment."
        />
        <div class="contact-info">
          <h2>Direct Contact</h2>
          <ul>
            <li><strong>Email</strong><a href={`mailto:${siteConfig.contact.emailEn}`}>{siteConfig.contact.emailEn}</a></li>
            <li><strong>Phone</strong><span>{siteConfig.contact.phone}</span></li>
            <li><strong>Address</strong><span>{siteConfig.contact.addressEn}</span></li>
          </ul>
        </div>
      </div>
      <div class="contact-layout__form">
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  .contact-info {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
  .contact-info h2 {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-sm);
  }
  .contact-info ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .contact-info li {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    font-size: var(--fs-sm);
  }
  .contact-info strong {
    color: var(--color-muted);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .contact-info a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .contact-info a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 960px) {
    .contact-layout {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>

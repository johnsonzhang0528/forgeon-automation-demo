---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import ContactForm from '../../../components/forms/ContactForm.astro';
import { siteConfig } from '../../../config/site';
import { getDictionary } from '../../../utils/i18n';

const locale = 'en' as const;
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  path="/en/contact/"
  otherLocalePath="/zh-tw/contact/"
  title="Contact & Project Request Form | FORGEON AUTOMATION"
  description="Submit your automation project background and requirements, and the FORGEON AUTOMATION engineering team will help evaluate a solution. You can also reach our technical contact directly by email or phone."
>
  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: 'Contact', path: '/en/contact/' }]} />
  </div>

  <section class="section section--tight">
    <div class="container contact-layout">
      <div class="contact-layout__intro">
        <div data-contact-intent>
          <SectionHeading
            level="h1"
            eyebrow="Contact"
            title={dict.contactIntent.projectHeading}
            description={dict.contactIntent.projectBody}
          />
        </div>
        <div class="contact-info">
          <h2>Direct Contact</h2>
          <ul>
            <li><strong>Email</strong><a href={`mailto:${siteConfig.contact.emailEn}`} data-track="contact_click" data-source="contact-page-direct">{siteConfig.contact.emailEn}</a></li>
            <li><strong>Phone</strong><span>{siteConfig.contact.phone}</span></li>
            <li><strong>Address</strong><span>{siteConfig.contact.addressEn}</span></li>
          </ul>
        </div>
      </div>
      <div class="contact-layout__form">
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  .contact-info {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
  .contact-info h2 {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-sm);
  }
  .contact-info ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .contact-info li {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    font-size: var(--fs-sm);
  }
  .contact-info strong {
    color: var(--color-muted);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .contact-info a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .contact-info a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 960px) {
    .contact-layout {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>

<script define:vars={{
  locale,
  strings: {
    technicalHeading: dict.contactIntent.technicalHeading,
    technicalBody: dict.contactIntent.technicalBody,
  },
}}>
  // CTA intent handling (spec P0.5): ?intent=project (default copy, no
  // change needed) vs ?intent=technical-advice (swaps the opening headline/
  // body to a lower-commitment framing and pre-selects the "Technical
  // Consultation" project type). Runs client-side because the intent comes
  // from a query param, which Astro's static output can't branch on at
  // build time.
  function initContactIntent() {
    const params = new URLSearchParams(window.location.search);
    const intent = params.get('intent');
    if (intent !== 'technical-advice' && intent !== 'project') return;

    if (intent === 'technical-advice') {
      const wrap = document.querySelector('[data-contact-intent]');
      const title = wrap?.querySelector('.section-heading__title');
      const desc = wrap?.querySelector('.section-heading__desc');
      if (title) title.textContent = strings.technicalHeading;
      if (desc) desc.textContent = strings.technicalBody;

      const projectTypeSelect = document.getElementById('projectType');
      if (projectTypeSelect instanceof HTMLSelectElement) {
        projectTypeSelect.value = 'consultation';
      }
    }

    window.dispatchEvent(new CustomEvent('forgeon:analytics', {
      detail: { event: 'cta_click', payload: { intent, locale, source: 'contact-page-landing' } },
    }));
  }

  initContactIntent();
</script>

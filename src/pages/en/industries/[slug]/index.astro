---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../../components/navigation/Breadcrumb.astro';
import FeatureList from '../../../../components/ui/FeatureList.astro';
import IndustryIcon from '../../../../components/ui/IndustryIcon.astro';
import Badge from '../../../../components/ui/Badge.astro';
import SolutionCard from '../../../../components/ui/SolutionCard.astro';
import ProductCard from '../../../../components/ui/ProductCard.astro';
import CTABanner from '../../../../components/sections/CTABanner.astro';
import StructuredData from '../../../../components/seo/StructuredData.astro';
import { getSortedIndustries, getSortedSolutions, getSortedProducts } from '../../../../utils/content';

export async function getStaticPaths() {
  const industries = await getSortedIndustries();
  return industries.map((ind) => ({ params: { slug: ind.data.entrySlug }, props: { industry: ind } }));
}

const { industry } = Astro.props;
const locale = 'en' as const;
const d = industry.data;
const allSolutions = await getSortedSolutions();
const allProducts = await getSortedProducts();
const suitableSolutions = allSolutions.filter((s) => d.suitableSolutions.includes(s.data.entrySlug));
const relatedProducts = allProducts.filter((p) => d.relatedProducts.includes(p.data.entrySlug));

const path = `/en/industries/${d.entrySlug}/`;
const otherLocalePath = `/zh-tw/industries/${d.entrySlug}/`;
---

<BaseLayout locale={locale} path={path} otherLocalePath={otherLocalePath} title={d.seoTitle.en} description={d.seoDescription.en}>
  <StructuredData breadcrumbs={[{ name: 'Industries', path: '/en/industries/' }, { name: d.name.en, path }]} />

  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: 'Industries', path: '/en/industries/' }, { label: d.name.en, path }]} />
  </div>

  <section class="section section--tight">
    <div class="container industry-hero">
      <IndustryIcon industry={d.entrySlug as any} size="lg" />
      <div>
        <Badge variant="demo">Concept Demonstration Content</Badge>
        <h1 class="industry-hero__title">{d.name.en}</h1>
        <p class="industry-hero__desc measure">{d.shortDescription.en}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--alt">
    <div class="container container--narrow">
      <SectionHeading eyebrow="Common Process Problems" title="Challenges This Industry Often Faces" />
      <FeatureList items={d.commonProblems.en} />
    </div>
  </section>

  {suitableSolutions.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeading eyebrow="Suitable Solutions" title="Recommended Automation Directions" />
        <div class="grid-auto">
          {suitableSolutions.map((s) => (
            <SolutionCard
              locale={locale}
              slug={s.data.entrySlug}
              name={s.data.name.en}
              description={s.data.shortDescription.en}
              hasDetailPage={s.data.hasDetailPage}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedProducts.length > 0 && (
    <section class="section section--tight section--alt">
      <div class="container">
        <SectionHeading eyebrow="Related Products" title="Compatible Products" />
        <div class="grid-auto">
          {relatedProducts.map((p) => (
            <ProductCard
              locale={locale}
              slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
              name={p.data.name}
              positioning={p.data.positioning.en}
              description={p.data.shortDescription.en}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container container--narrow">
      <SectionHeading eyebrow="Before You Start" title="Information to Prepare Before Evaluation" />
      <FeatureList items={d.prerequisites.en} />
    </div>
  </section>

  <div class="container">
    <CTABanner locale={locale} title="Want to discuss automation for this industry?" description="Submit your process background and we'll help evaluate a workable direction." />
  </div>
</BaseLayout>

<style>
  .industry-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .industry-hero__title {
    margin: var(--space-sm) 0 var(--space-sm);
  }
  .industry-hero__desc {
    color: var(--color-muted);
    font-size: var(--fs-md);
  }
  .container--narrow {
    max-width: 860px;
  }
</style>

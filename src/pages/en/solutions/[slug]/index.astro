---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../../components/navigation/Breadcrumb.astro';
import FeatureList from '../../../../components/ui/FeatureList.astro';
import ProcessTimeline from '../../../../components/ui/ProcessTimeline.astro';
import FAQAccordion from '../../../../components/ui/FAQAccordion.astro';
import CTABanner from '../../../../components/sections/CTABanner.astro';
import VisionGuidedAssemblyVisual from '../../../../components/sections/VisionGuidedAssemblyVisual.astro';
import ExistingLineRetrofitVisual from '../../../../components/sections/ExistingLineRetrofitVisual.astro';
import MachineVisionInspectionVisual from '../../../../components/sections/MachineVisionInspectionVisual.astro';
import PrecisionHandlingVisual from '../../../../components/sections/PrecisionHandlingVisual.astro';
import FieldCommissioningVisual from '../../../../components/sections/FieldCommissioningVisual.astro';
import SystemArchitectureDiagram from '../../../../components/sections/SystemArchitectureDiagram.astro';
import Badge from '../../../../components/ui/Badge.astro';
import ProductCard from '../../../../components/ui/ProductCard.astro';
import StructuredData from '../../../../components/seo/StructuredData.astro';
import { getSortedSolutions, getSortedProducts } from '../../../../utils/content';

export async function getStaticPaths() {
  const solutions = await getSortedSolutions();
  return solutions.map((s) => ({ params: { slug: s.data.entrySlug }, props: { solution: s } }));
}

const { solution } = Astro.props;
const locale = 'en' as const;
const d = solution.data;
const allProducts = await getSortedProducts();
const compatibleProducts = allProducts.filter((p) => d.compatibleProducts.includes(p.data.entrySlug));
const isFullDetail = d.hasDetailPage;

const path = `/en/solutions/${d.entrySlug}/`;
const otherLocalePath = `/zh-tw/solutions/${d.entrySlug}/`;
---

<BaseLayout
  locale={locale}
  path={path}
  otherLocalePath={otherLocalePath}
  title={d.seoTitle.en}
  description={d.seoDescription.en}
>
  {isFullDetail && d.faq && (
    <StructuredData
      breadcrumbs={[
        { name: 'Solutions', path: '/en/solutions/' },
        { name: d.name.en, path },
      ]}
      faq={d.faq.map((f) => ({ question: f.question.en, answer: f.answer.en }))}
    />
  )}
  {!isFullDetail && (
    <StructuredData breadcrumbs={[{ name: 'Solutions', path: '/en/solutions/' }, { name: d.name.en, path }]} />
  )}

  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: 'Solutions', path: '/en/solutions/' }, { label: d.name.en, path }]} />
  </div>

  <section class="section section--tight">
    <div class="container container--narrow">
      <Badge variant="demo">Concept Demonstration Content</Badge>
      <h1 class="detail-title">{d.name.en}</h1>
      <p class="detail-summary measure">{d.heroSummary.en}</p>
      {d.entrySlug === 'vision-guided-assembly' && (
        <VisionGuidedAssemblyVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'line-upgrade' && (
        <ExistingLineRetrofitVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'vision-inspection' && (
        <MachineVisionInspectionVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'precision-positioning' && (
        <PrecisionHandlingVisual locale={locale} presentation="wide" priority />
      )}
      {d.entrySlug === 'custom-integration' && (
        <FieldCommissioningVisual locale={locale} presentation="wide" priority />
      )}
    </div>
  </section>

  <section class="section section--tight section--alt">
    <div class="container container--narrow two-col">
      <div>
        <h2>The Problem</h2>
        <p>{d.problem.en}</p>
      </div>
      <div>
        <h2>The Approach</h2>
        <p>{d.approach.en}</p>
      </div>
    </div>
  </section>

  {d.entrySlug === 'line-upgrade' && (
    <section class="section section--tight">
      <div class="container">
        <SystemArchitectureDiagram locale={locale} variant="line-upgrade" />
      </div>
    </section>
  )}

  {isFullDetail && d.background && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Background" title="Why Vision Guidance Matters" />
        <p class="measure">{d.background.en}</p>
      </div>
    </section>
  )}

  {isFullDetail && d.scenarios && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Applicable Scenarios" title="When This Solution Fits" />
        <FeatureList items={d.scenarios.en} />
      </div>
    </section>
  )}

  {isFullDetail && d.systemComponents && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeading eyebrow="System Components" title="What the Solution Includes" />
        <SystemArchitectureDiagram locale={locale} variant="vision-guided-assembly" headingLevel="h3" />
        <div class="system-components-list">
          <FeatureList items={d.systemComponents.en} />
        </div>
      </div>
    </section>
  )}

  {isFullDetail && d.workflow && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Workflow" title="How It Works" />
        <ProcessTimeline
          steps={d.workflow.map((w) => ({ title: w.title.en, description: w.description.en }))}
        />
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container container--narrow two-col">
      <div>
        <h2>Key Benefits</h2>
        <FeatureList items={d.keyBenefits.en} />
      </div>
      <div>
        <h2>Applicable Industries</h2>
        <ul class="plain-list">
          {d.applicableIndustries.en.map((ind) => <li>{ind}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {isFullDetail && d.integrableEquipment && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Integrable Equipment" title="Compatible Equipment Types" />
        <FeatureList items={d.integrableEquipment.en} />
      </div>
    </section>
  )}

  {isFullDetail && d.advantages && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Advantages" title="Why This Approach Works" />
        <FeatureList items={d.advantages.en} />
      </div>
    </section>
  )}

  {isFullDetail && d.prerequisites && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Before You Start" title="What to Prepare Before Evaluation" />
        <FeatureList items={d.prerequisites.en} />
      </div>
    </section>
  )}

  {isFullDetail && d.entrySlug === 'vision-guided-assembly' && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Fit Check" title="When This Solution Fits, and When It Doesn't" />
        <div class="fit-grid">
          <div class="fit-card fit-card--yes">
            <h3>Good Fit</h3>
            <ul>
              <li>Part tolerance offset or inconsistent incoming orientation means fixed mechanical fixtures can no longer align reliably</li>
              <li>The same line produces multiple variants that need fast recognition-parameter changeover</li>
              <li>You want visual or feature inspection to happen alongside assembly, reducing station count</li>
              <li>You can already provide actual dimensional drawings and tolerance ranges for the engineering team to evaluate camera and lighting configuration</li>
            </ul>
          </div>
          <div class="fit-card fit-card--no">
            <h3>Not a Fit Yet</h3>
            <ul>
              <li>Parts are highly reflective or transparent, and no viable specialized lighting approach has been confirmed</li>
              <li>On-site lighting conditions fluctuate significantly with no way to adjust or add stable lighting</li>
              <li>You only need positioning for a single fixed variant with very tight tolerance; a fixed mechanical fixture may already be sufficient, without the added cost of a vision system</li>
              <li>You haven't yet confirmed whether the floor space can accommodate camera and lighting modules</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {isFullDetail && d.entrySlug === 'vision-guided-assembly' && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="Concept Scenario" title="A Fictional Project Scenario" description="The scenario below is entirely fictional demonstration content, shown to illustrate the full flow from problem to deliverable. It does not represent any real customer or project." />
        <div class="scenario-block">
          <div class="scenario-item">
            <h3>Fictional Problem Background</h3>
            <p>A fictional electronics contract manufacturer runs connector assembly on an existing line using fixed fixtures. A recent supplier change means incoming parts no longer arrive in consistent orientation, and the fixed fixture's alignment failure rate has risen noticeably. The line manager needs to evaluate whether to introduce vision-guided positioning.</p>
          </div>
          <div class="scenario-item">
            <h3>User Roles</h3>
            <p>A process engineer provides part drawings and line takt-time data; a procurement contact confirms budget range and target timeline. Either role could be the one who actually submits the RFQ form.</p>
          </div>
          <div class="scenario-item">
            <h3>Data Inputs</h3>
            <p>Part dimensional drawings, current line takt time, whether existing fixtures can be reused, a description of on-site lighting conditions, and target yield.</p>
          </div>
          <div class="scenario-item">
            <h3>Solution Selected</h3>
            <p>Based on the inputs above, the evaluated direction is the vision-guided automated assembly solution, pairing VISION-X2 for recognition and positioning with AXM-400 for the subsequent alignment motion.</p>
          </div>
          <div class="scenario-item">
            <h3>Deliverables (demonstration only, not a real commitment)</h3>
            <p>A technical evaluation report, a system architecture diagram, a preliminary quote range, and a recommended implementation timeline. These items illustrate what this site's RFQ flow is designed to collect and produce; they do not represent any real delivery record.</p>
          </div>
          <div class="scenario-item">
            <h3>Acceptance Criteria (demonstration only)</h3>
            <p>On-site testing against agreed positioning accuracy and yield targets. Results depend on actual site conditions; real targets would be set in a project contract, and this page makes no advance commitment.</p>
          </div>
        </div>
        <p class="scenario-disclaimer">This scenario includes no real outcome percentages, revenue figures, or customer testimonials. It exists solely to demonstrate the site's information architecture and RFQ flow design.</p>
      </div>
    </section>
  )}

  {compatibleProducts.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeading eyebrow="Compatible Products" title="Related Products" />
        <div class="grid-auto">
          {compatibleProducts.map((p) => (
            <ProductCard
              locale={locale}
              slug={p.data.entrySlug as 'axm-400' | 'vision-x2' | 'flexcell-m'}
              name={p.data.name}
              positioning={p.data.positioning.en}
              description={p.data.shortDescription.en}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {isFullDetail && d.faq && (
    <section class="section section--tight section--alt">
      <div class="container container--narrow">
        <SectionHeading eyebrow="FAQ" title="Frequently Asked Questions" />
        <FAQAccordion
          idPrefix="solution-faq"
          items={d.faq.map((f) => ({ question: f.question.en, answer: f.answer.en }))}
        />
      </div>
    </section>
  )}

  <div class="container">
    <CTABanner locale={locale} title="Want to discuss this solution further?" description="Submit your process background and our engineering team will help evaluate feasibility." />
  </div>
</BaseLayout>

<style>
  .detail-title {
    margin: var(--space-sm) 0 var(--space-md);
  }
  .detail-summary {
    color: var(--color-muted);
    font-size: var(--fs-md);
  }
  .container--narrow {
    max-width: 860px;
  }
  .system-components-list {
    max-width: 860px;
    margin: var(--space-xl) auto 0;
  }
  .two-col {
    display: grid;
    gap: var(--space-xl);
  }
  .two-col h2 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-sm);
  }
  .two-col p {
    color: var(--color-muted);
    margin: 0;
  }
  .fit-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .fit-card {
    background: var(--color-card);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    border-top: 3px solid var(--color-border-strong);
  }
  .fit-card--yes {
    border-top-color: var(--color-success);
  }
  .fit-card--no {
    border-top-color: var(--color-muted);
  }
  .fit-card h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-md);
  }
  .fit-card ul {
    margin: 0;
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .fit-card li {
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  @media (min-width: 720px) {
    .fit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .scenario-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .scenario-item {
    padding: var(--space-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .scenario-item h3 {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0 0 var(--space-2xs);
  }
  .scenario-item p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  .scenario-disclaimer {
    margin-top: var(--space-md);
    font-size: var(--fs-xs);
    color: var(--color-muted);
    font-style: italic;
  }
  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--color-ink-soft);
    font-size: var(--fs-sm);
  }
  .plain-list li {
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-accent-light);
  }
  @media (min-width: 720px) {
    .two-col {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script define:vars={{ slug: d.entrySlug, locale }}>
  // solution_view was defined in src/utils/analytics.ts but never actually
  // fired anywhere (spec 4.2) — this is the fix.
  window.dispatchEvent(new CustomEvent('forgeon:analytics', {
    detail: { event: 'solution_view', payload: { slug, locale } },
  }));
</script>

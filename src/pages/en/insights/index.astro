---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import InsightCard from '../../../components/ui/InsightCard.astro';
import { getSortedInsights } from '../../../utils/content';
import { getDictionary } from '../../../utils/i18n';

const locale = 'en' as const;
const dict = getDictionary(locale);
const insights = await getSortedInsights(locale);

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
}
---

<BaseLayout
  locale={locale}
  path="/en/insights/"
  otherLocalePath="/zh-tw/insights/"
  title="Insights | FORGEON AUTOMATION"
  description="Technical resource articles from FORGEON AUTOMATION covering automation implementation preparation and how to evaluate line upgrade versus rebuild decisions."
>
  <div class="container section--tight">
    <Breadcrumb locale={locale} items={[{ label: 'Insights', path: '/en/insights/' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        level="h1"
        eyebrow="Insights"
        title="Practical Reference for Automation Projects"
        description="Practical technical information to help evaluate preparation and decisions for automation projects."
      />
      <div class="insights-list">
        {insights.map((post) => (
          <InsightCard
            locale={locale}
            insight={post.data.entrySlug}
            href={`/en/insights/${post.data.entrySlug}/`}
            dateIso={post.data.publishDate.toISOString()}
            dateLabel={formatDate(post.data.publishDate)}
            title={post.data.title}
            summary={post.data.summary}
            linkLabel={dict.misc.readMore}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .insights-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .insights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import '../styles/global.css';
import '../styles/utilities.css';
import type { Locale } from '../config/site';
import { getHtmlLang } from '../utils/i18n';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AnalyticsBridge from '../components/layout/AnalyticsBridge.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { siteConfig, allowIndexing } from '../config/site';

export interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  otherLocalePath?: string;
  ogImage?: string;
  /** Explicit per-page override. When unset, falls back to the Demo Mode
   * gate (`!allowIndexing`) so noindex is the default everywhere unless a
   * page opts out AND the site is in Production Mode — see P0.4 in
   * docs/REMEDIATION_PLAN.md and src/config/site.ts. */
  noindex?: boolean;
  bodyClass?: string;
}

const {
  locale,
  path,
  title,
  description,
  otherLocalePath,
  ogImage,
  noindex,
  bodyClass = '',
} = Astro.props;

const resolvedNoindex = noindex ?? !allowIndexing;

const skipLabel = locale === 'zh-tw' ? '跳到主要內容' : 'Skip to content';
const gtmId = siteConfig.gtmId;
---

<!doctype html>
<html lang={getHtmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <!--
      Preload only the one weight that is genuinely above-the-fold-critical:
      Noto Sans TC 400 renders every zh-tw page's body copy and (via the
      :lang(zh) override in global.css) its H1 on first paint. Space
      Grotesk/IBM Plex Mono are not preloaded — they only affect Latin
      display text and technical labels, neither of which is the LCP
      element on any current page, so preloading them would compete with
      the font that actually blocks first meaningful paint (spec §5.6:
      "首屏真正需要的字型才可 Preload").
    -->
    <link
      rel="preload"
      href="/fonts/noto-sans-tc/noto-sans-tc-chinese-traditional-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <SEOHead
      locale={locale}
      path={path}
      title={title}
      description={description}
      otherLocalePath={otherLocalePath}
      ogImage={ogImage}
      noindex={resolvedNoindex}
    />
    <StructuredData organization website />

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <Header locale={locale} path={path} otherLocalePath={otherLocalePath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <AnalyticsBridge />
  </body>
</html>

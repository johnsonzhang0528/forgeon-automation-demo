# Controls what `git archive` includes — used by
# scripts/create-review-bundle.sh --full for milestone review bundles.
# Does not affect normal git operations (clone, checkout, diff).

node_modules/** export-ignore
dist/** export-ignore
.astro/** export-ignore
.git/** export-ignore
.review-bundles/** export-ignore
test-results/** export-ignore
playwright-report/** export-ignore
public/fonts/** export-ignore
.env export-ignore
.env.* export-ignore

# Third-party skill packages under .claude/skills/ are installed tooling,
# not this project's own source — excluded from --full archives so a
# review bundle stays scoped to the actual site. Their documentation also
# legitimately discusses several credential-related env-var name patterns
# as examples, which otherwise trips the bundle script's secret-content
# scan (see scripts/create-review-bundle.sh's FORBIDDEN_CONTENT_PATTERNS).
.claude/skills/** export-ignore
